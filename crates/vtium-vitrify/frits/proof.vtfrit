# proof: vtium/vtium#23's proof frit, a desktop font from installed fonts:
# a code font for text, Nerd Fonts' symbols for their private-use range,
# and Noto Color Emoji for emoji, from 12 points. vtium ships this frit,
# never the fonts; the helper leaves a font missing on the target out.
#
# Licences, as each source's documentation gives them:
# - JetBrains Mono: SIL OFL 1.1.
# - Symbols Nerd Font Mono: MIT for the patcher, each icon set under its
#   own, as Nerd Fonts' license audit lists them. Font Logos (U+F300-U+F385)
#   carries no licence grant and is left out.
#
# Attribution, which CC-BY-4.0 asks of the icon sets this frit takes:
# - Font Awesome by Fonticons, Inc. (https://fontawesome.com), icons under
#   CC-BY-4.0, through Nerd Fonts (U+ED00-U+F2FF, less U+EE00-U+EE0B).
# - Nerd Fonts' own progress glyphs, MIT, U+EE00-U+EE0B.
# - Codicons by Microsoft Corporation (https://github.com/microsoft/vscode-codicons),
#   CC-BY-4.0, through Nerd Fonts (U+EA60-U+EC84).
# - Material Design Icons by Pictogrammers (https://pictogrammers.com),
#   Apache-2.0, through Nerd Fonts (U+F0001-U+F1AF0).
# - Noto Color Emoji: SIL OFL 1.1.

name=proof
license=OFL-1.1 AND MIT AND Apache-2.0 AND CC-BY-4.0

# Text, setting the cell at each size. Written against ttf-jetbrains-mono
# 2.304-2 (Arch), JetBrainsMono-Regular.ttf, SHA-256
# a0bf60ef0f83c5ed4d7a75d45838548b1f6873372dfac88f71804491898d138f.
source=font:JetBrains Mono
# Arch's ttf-jetbrains-mono installs it.

# Nerd Fonts' symbols, one cell wide: their private-use ranges, the Basic
# Multilingual Plane's around Font Logos, and Material Design's.
source=font:Symbols Nerd Font Mono
# Arch's ttf-nerd-fonts-symbols-mono installs it.
cover=U+E000-U+F2FF
cover=U+F386-U+F8FF
cover=U+F0001-U+F1AF0

# Every emoji Noto Color Emoji maps, two cells wide. Written against
# noto-fonts-emoji 1:2.057-1 (Arch), NotoColorEmoji.ttf, SHA-256
# 15671215ab769fdc7162a045d56fd7d7e477c51b04e6b3c761d914d8fdd6cc44.
source=font:Noto Color Emoji
# Arch's noto-fonts-emoji installs it.

# The starting size, in points: 16 pixels at 96 DPI. A zoom steps from it
# by a point (ADR-1200 D1, D17).
size=12
