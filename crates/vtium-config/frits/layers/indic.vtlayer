# indic: Devanagari and the other Indic scripts, one Noto font for each:
# Devanagari (Hindi, Marathi, Nepali, Sanskrit), Bengali (Bengali,
# Assamese), Gurmukhi (Punjabi), Gujarati, Odia, Tamil, Telugu, Kannada,
# Malayalam and Sinhala. A font set adds this layer after Noto Sans Mono,
# which holds none of them, and each font draws at Noto Sans Mono's size.
# A machine needs only the fonts of the scripts it shows, because the font
# helper leaves out a font that the machine lacks.
#
# Indic scripts stack signs above and below each letter: vowel signs
# (matras), the reph over a cluster, and the lower half of a conjunct under
# it. Each script's signs may use the rows that the set's line spacing
# adds.
#
# License: every font below is under the SIL OFL 1.1.
#
# References:
# - ADR-1204 D5: the script layers.
# - ADR-1302 D13: line spacing and fit=.

role=script
