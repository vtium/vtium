# tiny5: the smallest font vtium draws, Tiny5 Mono at its own 6x9 cell, 6
# pixels wide being the narrowest cell a font set may state, with the small
# panels' chosen icons and emoji. It is never a default, and vtium names it
# nowhere, so a person who wants it names it in font-name or in a look. The
# sizes below were measured for vtium/vtium#197.
# Tiny5 Mono is a pixel font whose capitals are 5 pixels tall, drawn on a
# 6-pixel advance with 7 rows above the baseline and 2 below. At 6x9 a
# 320x240 panel holds 53x26 cells and a 640x480 one 106x53, where the
# built-in Unscii-8's 8x8 gives 40x30 and 80x60. It holds all of ASCII,
# Latin-1, code page 437, Greek, Armenian, box drawing, blocks and
# Braille, most of Cyrillic and of Symbols for Legacy Computing, 4,882
# characters in all, each one cell wide. vtium ships this frit, never the
# font. The vtium-fonts package brings the BDF file, and the font helper
# leaves the source out when the file is missing.
#
# The two small layers add Nerd Fonts' icons and color emoji, drawn to fit
# the 6x9 cell. GNU Unifont, the last layer, holds 8x16 glyphs, which do
# not fit the cell, so the console draws every character that the sources
# before it lack in the built-in font for the cell, Unscii-8 here, centered
# in the 6x9 cell with a column cut off each side.
#
# Box drawing, blocks, Braille, sextants, octants and Legacy Computing
# draw as vtium's sprites, the default glyph-source, which line up across
# cells. Tiny5 Mono's own box and block glyphs fill the cell too;
# glyph-source=font draws them instead.
#
# Bold is weak at this size: vtium draws bitmap bold by widening each row
# by a pixel, and with 5-pixel glyphs and a 1-pixel gap that fills the
# counters of letters such as x and 0.
#
# Licenses, as each source's documentation gives them; the layers name
# their own:
# - Tiny5 Mono: SIL OFL 1.1, "Copyright 2026 The Tiny5 Mono Project
#   Authors (https://github.com/Gissio/font_Tiny5Mono)", as the BDF's
#   COPYRIGHT property gives it; it names no Reserved Font Name. The
#   repository's OFL.txt still carries its template's placeholder
#   copyright line.

name=tiny5
cell=6x9
license=OFL-1.1 AND MIT

# Tiny5 Mono's BDF, the font at its own cell. Written against
# github.com/Gissio/font_Tiny5Mono at 7d30f9e887fdb29e0b951e92493822afba5f70a7
# (version 3.000), file fonts/bdf/Tiny5Mono.bdf, SHA-256
# 33a935687277817534ddcc1decf586d977cee211550f611ba4bb4365e99755d3.
# No distribution packages Tiny5 Mono, so the vtium-fonts package carries
# that file and installs it at the path below. On a distribution without
# vtium-fonts, download the file from the repository at that commit, check
# its SHA-256, and copy it to the path below as root. The file and each
# folder above it must belong to root, and the file must be readable by
# every account, since the helper reads it as nobody before login. Either
# way, vtium draws the font only once the font is active.
# vtium-config reads the file as published: it takes the character set
# from the XLFD name, as the file has no CHARSET_REGISTRY property, and
# leaves out the 73 small capitals of ENCODING -1, which the file's CHARS
# line does not count.
# No cover= line: every glyph the file holds is one cell wide and drawn in
# the cell.
source=bdf:/usr/share/fonts/vtium/Tiny5Mono.bdf
version=3.000
sha256=33a935687277817534ddcc1decf586d977cee211550f611ba4bb4365e99755d3
url=https://github.com/Gissio/font_Tiny5Mono/tree/7d30f9e887fdb29e0b951e92493822afba5f70a7

layer=nerd-symbols-small
layer=noto-emoji-small
layer=unifont
