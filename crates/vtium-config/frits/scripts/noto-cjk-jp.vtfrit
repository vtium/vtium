# noto-cjk-jp: a font set for Chinese, Japanese and Korean, with Han
# characters in the forms Japanese uses. Noto Sans Mono draws Latin text and
# sets the character cell, and Noto Sans CJK JP draws Han, kana and Hangul
# at Noto Sans Mono's size.
#
# The set adds Nerd Fonts' icons and color emoji after the script, and
# GNU Unifont last, which draws every other character. vtium ships this
# font set, never the fonts. The font helper leaves out a font that the
# machine lacks, and the next source that holds a character draws it.
#
# Unicode encodes each Han character once, even where China, Taiwan, Japan
# and Korea each write it in a slightly different form, such as 直, 骨 and
# 刃. Noto Sans CJK holds each region's forms in a face of its own, so the
# catalog has one font set for each region: noto-cjk-sc for mainland China
# and Singapore, noto-cjk-tc for Taiwan, noto-cjk-jp for Japan and
# noto-cjk-kr for Korea. The four sets draw the same characters, and only
# the forms of Han differ between them.
#
# Han, kana and Hangul carry no marks above or below the letters, and Noto
# Sans CJK draws them inside the text's height. At 32 pixels of text, its ink
# leaves 5 rows blank above it and 4 below it, so the set adds no line
# spacing.
#
# Licenses: Noto Sans Mono and the script's Noto fonts are under the SIL OFL
# 1.1. The layers name their own licenses.
#
# References:
# - ADR-1204 D3: the scripts and regions category.
# - ADR-1302 D13: the line spacing.

name=noto-cjk-jp
license=OFL-1.1 AND MIT AND Apache-2.0 AND CC-BY-4.0

# Latin text, setting the cell at each size.
source=font:Noto Sans Mono
version=2.014
url=https://github.com/notofonts/latin-greek-cyrillic/releases/tag/NotoSansMono-v2.014

layer=cjk-jp
layer=nerd-symbols
layer=noto-emoji
layer=unifont

line-spacing=0
