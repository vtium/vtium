# vtium on a VT of seat0, in place of getty. This is the source of the VT
# unit: tools/vt/units.sh generates vtium@.service from it for the package,
# make install and make install-tree, and vtium-dev@.service for make
# vt-install, and replaces its DefaultInstance= with one that names no VT
# (ADR-1500 D3, D4). The instance is the VT's name, as getty@.service's is.
# It conflicts with getty@ on the same VT. When vtium fails, systemd starts
# it again after 100 ms, up to systemd's default limit of 5 starts in 10 s,
# and from systemd 254 on each failure also starts vtium-getty@, which
# starts getty@ on the VT unless the head file's policy is closed (ADR-1401
# D9) or the getty's start would stop another program, such as a display
# manager whose Conflicts= names the getty (ADR-1500 D7). So under an open
# policy the getty takes the VT at the first failure, and starting it stops
# this unit; under a closed one vtium comes back, and past the limit the
# unit stays failed with no login on the VT. Without VTs it starts nothing.
#
# The ordering and the TTY settings are getty's. The unit sets no
# sandboxing directive: the login session vtium starts would inherit it
# (ADR-1400, D3).

[Unit]
Description=vtium on %I
After=systemd-user-sessions.service
After=plymouth-quit-wait.service
After=rc-local.service
After=systemd-vconsole-setup.service
Before=getty.target
# Conflicts= orders nothing (systemd.unit(5): to have the conflicting unit
# stopped before this one starts, an After= or Before= is needed, and stop
# jobs then always run before start jobs). Without it, starting vtium while
# getty@ runs on the VT stops the getty and starts vtium in parallel, and the
# getty's TTYVHangup= and TTYVTDisallocate= reset can hang up vtium's tty.
# With it, the getty has stopped before vtium starts, and in the other
# direction vtium has stopped before the fallback's getty starts.
Conflicts=getty@%i.service
After=getty@%i.service
OnFailure=vtium-getty@%i.service
IgnoreOnIsolate=yes
ConditionPathExists=/dev/tty0

[Service]
ExecStart=/usr/bin/vtium --vt=%I --no-switchvt
UtmpIdentifier=%I
TTYPath=/dev/%I
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
Restart=on-failure

[Install]
Alias=autovt@.service
WantedBy=getty.target
DefaultInstance=tty1
