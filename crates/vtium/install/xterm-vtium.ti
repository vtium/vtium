# vtium's terminfo entry. vtium sets TERM=xterm-vtium by default, so a session
# finds this entry, and vtium answers XTGETTCAP from it under that name only.
# Under TERM=kmscon vtium answers from the C reference's table, kmscon.ti's.
# The name starts with "xterm-" because programs that do not know vtium
# recognize an xterm-like terminal by that prefix: mc, for one, turns its
# mouse on. The entry describes what vtium does, which is largely what kitty
# does, so where vtium behaves as kitty does, a capability is written as
# kitty's entry writes it.
#
# Install it compiled with tic -x. The XTGETTCAP table in
# crates/vtium/src/termcap/table.rs is generated from this file, and a test
# fails when they differ: VTIUM_BLESS=1 cargo test -p vtium termcap rewrites
# the table.
#
# Each comment names the rows of docs/architecture/term/ADR-1000-*.tsv that
# say vtium supports what the capabilities below it ask for. The core of the
# entry is the C reference's kmscon entry (scripts/terminfo/kmscon.ti at
# kmscon b1f7a7c5), whose probes judge it.
#
# Left out on purpose:
# - fullkbd, kitty's sign of its keyboard protocol: vtium does not build the
#   protocol yet (input.kitty-keyboard).
# - RGB: with colors#256, ncurses would read setaf's palette indices as
#   packed red, green and blue. Tc and setrgbf/setrgbb carry direct color.
# - smkx and rmkx: the key capabilities below are the keys vtium sends with
#   DECCKM reset, the state a program finds at start.
# - hs, tsl, fsl and dsl: vtium ignores titles (window.title).
xterm-vtium|VTium terminal for the Linux console,
# DEC-7 (am), ctl.bce (bce), DEC-1036 (km), ANSI-4 (mir), ctl.edit (msgr,
# npc, xenl)
  am, bce, km, mir, msgr, npc, xenl,
# sgr.palette, sgr.extended-color
  colors#256, pairs#32767,
  cols#80, lines#24,
# ctl.tabs: a tab stop every 8 columns at start
  it#8,

# Character set mapping, VT100 line drawing
  acsc=``aaffggiijjkkllmmnnooppqqrrssttuuvvwwxxyyzz{{||}}~~,
# Basic controls
  bel=^G, cr=\r, cud1=\n, ht=^I, ind=\n,

# Cursor movement (ctl.edit)
  cub1=^H, cuf1=\E[C, cuu1=\E[A,
  cub=\E[%p1%dD, cud=\E[%p1%dB, cuf=\E[%p1%dC, cuu=\E[%p1%dA,
  cup=\E[%i%p1%d;%p2%dH, home=\E[H,
  hpa=\E[%i%p1%dG, vpa=\E[%i%p1%dd,

# Erasure (ctl.edit). E3 is ED 3, which empties the scrollback (ctl.ed3);
# clear(1) sends it after clear, as under linux and xterm-256color.
  clear=\E[H\E[2J, ed=\E[J, el=\E[K, el1=\E[1K,
  ech=\E[%p1%dX, cbt=\E[Z, E3=\E[3J,

# Insert and delete (ctl.edit). smir and rmir set and reset insert mode
# (ANSI-4).
  dch1=\E[P, dch=\E[%p1%dP,
  dl1=\E[M, dl=\E[%p1%dM,
  ch1=\E[@, ich=\E[%p1%d@,
  il1=\E[L, il=\E[%p1%dL,
  ich1=\E[@,
  smir=\E[4h, rmir=\E[4l,

# Automatic margins, DECAWM (DEC-7)
  smam=\E[?7h, rmam=\E[?7l,

# Rendition: sgr.bold, sgr.dim, sgr.underline, sgr.blink, sgr.inverse,
# sgr.conceal, sgr.italic
  sgr=%?%p9%t\E(0%e\E(B%;\E[0%?%p6%t;1%;%?%p5%t;2%;%?%p2%t;4%;%?%p1%p3%|%t;7%;%?%p4%t;5%;%?%p7%t;8%;m,
  sgr0=\E(B\E[m, bold=\E[1m, smul=\E[4m,
  rev=\E[7m, smso=\E[7m, rmso=\E[27m,
  rmul=\E[24m, smacs=\E(0, rmacs=\E(B,
  blink=\E[5m, invis=\E[8m,
  flash=\E[?5h$<200/>\E[?5l,
  dim=\E[2m, sitm=\E[3m, ritm=\E[23m,

# Strike-through (user-defined capabilities, ncurses' ecma+strikeout):
# sgr.strike
  smxx=\E[9m, rmxx=\E[29m,

# Palette colors, as xterm-256color writes them (sgr.palette,
# sgr.extended-color)
  setab=\E[%?%p1%{8}%<%t4%p1%d%e%p1%{16}%<%t10%p1%{8}%-%d%e48;5;%p1%d%;m,
  setaf=\E[%?%p1%{8}%<%t3%p1%d%e%p1%{16}%<%t9%p1%{8}%-%d%e38;5;%p1%d%;m,
  op=\E[39;49m,

# Changing the palette with OSC 4 and resetting it with OSC 104, as kitty's
# entry writes them (color.palette.set): initc takes each channel from 0 to
# 1000 and writes it as two hex digits.
  ccc,
  initc=\E]4;%p1%d;rgb:%p2%{255}%*%{1000}%/%2.2X/%p3%{255}%*%{1000}%/%2.2X/%p4%{255}%*%{1000}%/%2.2X\E\\,
  oc=\E]104\007,

# 24-bit direct color (user-defined capabilities): sgr.extended-color. Each
# ends in 'm' with no empty final parameter, which xterm reads as SGR 0.
  Tc,
  setrgbb=\E[48;2;%p1%d;%p2%d;%p3%dm,
  setrgbf=\E[38;2;%p1%d;%p2%d;%p3%dm,

# Underline styles and color (user-defined capabilities): sgr.underline-style,
# sgr.underline-color. Su says the terminal draws styled underlines, as
# kitty's entry says it. Smulx is SGR 4:n, 0 (none) to 5 (dashed). Setulc
# takes one color packed as r*65536 + g*256 + b, as tmux(1) passes it, and
# writes ITU T.416's colon form 58:2::r:g:b with the color space empty, which
# a terminal that does not know SGR 58 cannot read as SGR 2 (dim) and the
# rest, as it would the semicolon form.
  Su,
  Smulx=\E[4:%p1%dm,
  Setulc=\E[58:2::%p1%{65536}%/%d:%p1%{256}%/%{255}%&%d:%p1%{255}%&%dm,

# Scrolling and margins (ctl.decstbm, ctl.edit)
  csr=\E[%i%p1%d;%p2%dr,
  indn=\E[%p1%dS, rin=\E[%p1%dT,
  ri=\EM,

# Alternate screen (DEC-1049)
  smcup=\E[?1049h, rmcup=\E[?1049l,

# Cursor visibility (DEC-25)
  civis=\E[?25l, cnorm=\E[?25h,

# Cursor shape, DECSCUSR (user-defined capabilities): cursor.style
  Se=\E[0 q, Ss=\E[%p1%d q,

# Cursor color with OSC 12 and its reset with OSC 112 (user-defined
# capabilities, as kitty's entry writes them): color.dynamic.set
  Cs=\E]12;%p1%s\007, Cr=\E]112\007,

# Synchronized output (user-defined capability, tmux(1)'s Sync): mode 2026
# (DEC-2026), begun with %p1 1 and ended with %p1 2. vtium also takes the
# DCS = 1 s form kitty's entry writes (ctl.sync-update); the mode is the
# form more terminals share.
  Sync=\E[?2026%?%p1%{1}%-%tl%eh%;,

# Setting the selection with OSC 52 (user-defined capability, as xterm's
# entry and tmux(1) name it): osc.52.write. %p1 is the selections and %p2
# the data in base64. vtium answers no query (osc.52.read).
  Ms=\E]52;%p1%s;%p2%s\007,

# Focus events, mode 1004 (user-defined capabilities, ncurses' xterm+focus):
# DEC-1004
  XF, fd=\E[?1004l, fe=\E[?1004h, kxIN=\E[I, kxOUT=\E[O,

# SGR mouse, modes 1000 and 1006 (user-defined capability XM, ncurses'
# xterm+sm+1006): DEC-1000, DEC-1006. ncurses reads XM to turn the mouse on
# and, finding 1006 in it, decodes the SGR reports; kmous is the prefix it
# matches them by. SGR reports carry any column, where the X10 form that
# kmous=\E[M names stops at column 223. xm, which no program reads
# (user_caps(5)), is left out.
  kmous=\E[<, XM=\E[?1006;1000%?%p1%{1}%=%th%el%;,

# Bracketed paste, mode 2004 (user-defined capabilities, ncurses'
# bracketed+paste): DEC-2004
  BD=\E[?2004l, BE=\E[?2004h, PE=\E[201~, PS=\E[200~,

# The terminal's identity (user-defined capabilities, as kitty's entry writes
# them): XR asks for XTVERSION (query.xtversion) and RV for the secondary
# device attributes (query.da2).
  XR=\E[>0q, RV=\E[>c,

# Input keys, as vtium sends them with DECCKM reset (input.legacy)
  kbs=^?, kcub1=\E[D, kcud1=\E[B,
  kcuf1=\E[C, kcuu1=\E[A, kcbt=\E[Z,
  khome=\E[H, kend=\E[F, knp=\E[6~, kpp=\E[5~,
  kich1=\E[2~, kdch1=\E[3~,
  kf1=\EOP, kf2=\EOQ, kf3=\EOR, kf4=\EOS,
  kf5=\E[15~, kf6=\E[17~, kf7=\E[18~, kf8=\E[19~,
  kf9=\E[20~, kf10=\E[21~, kf11=\E[23~, kf12=\E[24~,
  kf13=\E[25~, kf14=\E[26~, kf15=\E[28~, kf16=\E[29~,
  kf17=\E[31~, kf18=\E[32~, kf19=\E[33~, kf20=\E[34~,
  kf21=\E[23;2~, kf22=\E[24;2~,

# Cursor keys and Page Up and Page Down with modifiers (input.legacy), in
# xterm's form: CSI 1 ; m A for the cursor keys and CSI 5 ; m ~ for Page Up,
# where m is 1 plus 1 for Shift, 2 for Alt and 4 for Ctrl. The names with no
# digit are Shift's, and kri and kind are Shift with Up and Down, as kitty's
# entry has them; the user-defined names end in m (ncurses' xterm+pcc
# names).
  kLFT=\E[1;2D, kRIT=\E[1;2C, kri=\E[1;2A, kind=\E[1;2B,
  kUP=\E[1;2A, kDN=\E[1;2B,
  kUP3=\E[1;3A, kUP4=\E[1;4A, kUP5=\E[1;5A, kUP6=\E[1;6A, kUP7=\E[1;7A,
  kDN3=\E[1;3B, kDN4=\E[1;4B, kDN5=\E[1;5B, kDN6=\E[1;6B, kDN7=\E[1;7B,
  kRIT3=\E[1;3C, kRIT4=\E[1;4C, kRIT5=\E[1;5C, kRIT6=\E[1;6C, kRIT7=\E[1;7C,
  kLFT3=\E[1;3D, kLFT4=\E[1;4D, kLFT5=\E[1;5D, kLFT6=\E[1;6D, kLFT7=\E[1;7D,
  kPRV=\E[5;2~, kPRV5=\E[5;5~, kPRV6=\E[5;6~,
  kNXT=\E[6;2~, kNXT5=\E[6;5~, kNXT6=\E[6;6~,

# Miscellaneous: ctl.decsc (sc, rc), ctl.decstr (rs2), ctl.tabs (tbc, hts),
# text.rep (rep), query.dsr (u6, u7), query.da1 (u8, u9)
  sc=\E7, rc=\E8, rs2=\Ec, tbc=\E[3g, hts=\EH,
  rep=%p1%c\E[%p2%{1}%-%db,
  u6=\E[%i%d;%dR, u7=\E[6n, u8=\E[?%[;0123456789]c, u9=\E[c,
