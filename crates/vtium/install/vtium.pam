#%PAM-1.0
# The PAM stack of vtium's own session, which seat mode's unit,
# vtium-seat@.service, opens through PAMName=vtium (ADR-1400 D3). vtium needs no password
# to start: the person logs in later, at the login prompt that vtium shows,
# and /bin/login runs its own PAM stack for that. This stack opens a session
# so that pam_systemd registers it with logind, and libseat's logind backend
# then takes the seat from it. It is the session stack of a display
# manager's greeter, as Arch's sddm package ships it in
# /etc/pam.d/sddm-greeter.

# Load the environment from /etc/environment.
auth		required	pam_env.so
# vtium starts without authentication.
auth		required	pam_permit.so
# No account check is needed.
account		required	pam_permit.so
# No password can be changed here.
password	required	pam_deny.so
# The session, registered with logind where pam_systemd is installed.
session		required	pam_unix.so
session		optional	pam_systemd.so
