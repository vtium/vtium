# The getty fallback of kmsconvt@.service: when vtium on a VT fails, its
# OnFailure= starts this unit, which starts getty@ on that VT, so a user is
# never left at a dead screen. Under a closed head-file policy a getty's
# login would take any keyboard (ADR-1401 D9), so vtium writes
# /run/vtium/ttyN.closed at start, and this unit's condition skips the
# getty while that file exists. The file sits outside vtium's run
# directory, which systemd removes when vtium stops, before this condition
# is checked. vtium removes it when it next starts under an open policy,
# and /run is cleared at every boot.

[Unit]
Description=getty in place of vtium on %I
ConditionPathExists=!/run/vtium/%i.closed

[Service]
Type=oneshot
ExecStart=systemctl --no-block start getty@%i.service
