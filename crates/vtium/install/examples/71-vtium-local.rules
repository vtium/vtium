# vtium's example udev rules, installed as
# /usr/share/doc/vtium/examples/71-vtium-local.rules (ADR-1401 D4). vtium
# installs no active udev file: to use these rules, copy this file to
# /etc/udev/rules.d/ and change its matches to your devices. Each rule sets a
# property that a head file's `udev:` match reads, and the device identities
# here are illustrative. The file's number puts it after udev's rules that set
# ID_PATH, ID_VENDOR_ID and ID_MODEL_ID. Without a udev daemon a device has no
# properties, so these rules have no effect.

# The keyboard in the port pci-0000:15:00.0-usb-0:3.2, every interface of it,
# goes to the head `panel`; the head file's line:
#   input udev:VTIUM_HEAD=panel -> panel
SUBSYSTEM=="input", ENV{ID_PATH}=="pci-0000:15:00.0-usb-0:3.2*", ENV{VTIUM_HEAD}="panel"

# A device by its name, closed to every head; the head file's line:
#   input udev:VTIUM_IGNORE=1 -> ignore
SUBSYSTEM=="input", ATTRS{name}=="Headphones (AVRCP)", ENV{VTIUM_IGNORE}="1"

# A numpad by its vendor and product, which the anti-lockout guard does not
# count as a keyboard (ADR-1401 D9).
SUBSYSTEM=="input", ENV{ID_VENDOR_ID}=="aaaa", ENV{ID_MODEL_ID}=="0003", ENV{VTIUM_ROLE}="numpad"
