#!/usr/bin/env python3
"""
coverage - tie ADR-1000's tables to the tests that cover each row

Usage:
    docs/scripts/coverage [--update] [--layer LAYER] [--require]

The tables are docs/architecture/term/ADR-1000-modes.tsv and
ADR-1000-features.tsv (ADR-1000, "The tables as data"). Each row has a stable
`id`, and its `tests` column lists the tests that cite it. This script is the
only writer of `tests`.

A second file is generated from those columns: tools/conformance/COVERAGE.md,
which lists each capability of tools/conformance/capabilities.list with the
rows its scenario judges and the tests that guard those rows. The Rust code in
tools/conformance/src/coverage.rs is its one generator. With --update, this
script rewrites the `tests` columns first, because COVERAGE.md reads them.
Then it runs that generator through cargo:

    VTIUM_CONFORMANCE_BLESS=1 cargo test -p vtium-conformance --lib TEST

TEST is coverage_map_matches_the_capability_list_and_adr_1000, the test that
fails when COVERAGE.md is stale. With the variable set, it writes the file.

So docs/scripts/coverage --update brings both generated files up to date.
Without --update, the script reads files only and never runs cargo, so it
does not check COVERAGE.md. cargo test -p vtium-conformance checks it.

Ids:
    A mode's id is its kind and number: ANSI-4, DEC-2026.

    A feature's id is lowercase words joined by dots, the first naming the
    family: sgr, color, cursor, text, ctl, query, window, input, clipboard,
    osc, dcs, image or platform. A word holds a-z, 0-9 and inner hyphens.
    The osc family belongs to the group "Clipboard, shell integration and
    other OSC": there a row about one numbered OSC is osc.<number>, with
    further words where the row is part of it (osc.8, osc.52.write,
    osc.9.4). Examples: sgr.dim, ctl.decstbm, query.xtgettcap, platform.pty.

    An id never changes once committed, apart from the one rename ADR-1000
    records (#114). A row that moves to another group or
    is reworded keeps its id, and a removed row's id is not reused.

Which tests carry a tag:
    A tag goes on a test that drives the row's behaviour through the crate
    that implements it and checks the result. A test of a lower layer the
    row depends on, such as the parser under a reply vtium-term builds,
    carries no tag.

Tags:
    A Rust test names the rows it covers in a `// covers:` comment above its
    fn. Between the tag and the fn stand only comments, attributes and blank
    lines, and one of the attributes is a test attribute: #[test],
    #[tokio::test] or another whose path ends in `test`.

        // covers: DEC-1049, DEC-47
        #[test]
        fn alternate_screen_saves_the_cursor() { ... }

    The test is named crates/<crate>/tests/<file>.rs::<fn>.

    A tier 1 scenario (*.scenario, ADR-1504 D7) carries the tag in its
    header as a # comment, and the tag names the scenario's file. A tag of
    a scenario that tools/conformance/scenarios/provisional.tsv lists does
    not count yet, since a provisional transcript judges nothing: its ids
    are checked, and the row's tests column leaves the scenario out until
    it leaves the list. A capability scenario, one with a
    `# capability:` line, carries no tag, since capabilities.list names
    its rows; a tag there is an error. Ids in one tag
    are separated by commas or spaces, and a test may carry several tag
    lines. `covers:` matches in any case; a line holding `covers:` in any
    other form, such as /* covers: x */, is an error.

The `tests` column lists each row's tests sorted by name, joined by ", ".

Checks (exit 1 on any failure):
    - every id is well formed, a feature's family is in the list above, a
      mode's id matches its kind and number, and no id appears twice across
      the two tables;
    - every tag is readable, names a known id, and in Rust sits above a test;
    - each committed `tests` cell equals what the tags give.
    With --require, every selected row has a test, apart from a mode whose
    note says it is not in vtium's mode table, which DECRQM answers 0.

Options:
    --update         rewrite the `tests` columns from the tags, then
                     regenerate tools/conformance/COVERAGE.md through cargo
    --layer LAYER    select the rows whose layer column names LAYER
                     (minspec, text, bidi, images, gpu, seat or top)
    --require        fail while a selected row that needs a test has none

Exit 0 when every check passes, 1 when one fails or when --update cannot
regenerate COVERAGE.md, 2 when the scan found no Rust or scenario files, a
table cannot be read, or no row has LAYER.
"""

import argparse
import os
import re
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent.parent
TABLES = [
    ROOT / 'docs/architecture/term/ADR-1000-modes.tsv',
    ROOT / 'docs/architecture/term/ADR-1000-features.tsv',
]

FAMILIES = {'sgr', 'color', 'cursor', 'text', 'ctl', 'query', 'window', 'input',
            'clipboard', 'osc', 'dcs', 'image', 'platform'}
OSC_GROUP = 'Clipboard, shell integration and other OSC'

MODE_ID = re.compile(r'(ANSI|DEC)-(0|[1-9][0-9]*)')
WORD = r'[a-z0-9]+(?:-[a-z0-9]+)*'
FEATURE_ID = re.compile(rf'[a-z][a-z0-9]*(?:\.{WORD})+')

RUST_TAG = re.compile(r'^\s*//[/!]?\s*covers:(.*)$', re.IGNORECASE)
SCENARIO_TAG = re.compile(r'^\s*#+\s*covers:(.*)$', re.IGNORECASE)
NEAR_MISS = re.compile(r'covers:', re.IGNORECASE)
TEST_ATTR = re.compile(r'^#\[\s*(?:[A-Za-z_][A-Za-z0-9_]*\s*::\s*)*test\s*[\](]')
RUST_FN = re.compile(
    r'^\s*(?:pub(?:\([^)]*\))?\s+)?(?:const\s+)?(?:async\s+)?(?:unsafe\s+)?'
    r'(?:extern\s+"[^"]*"\s+)?fn\s+([A-Za-z_][A-Za-z0-9_]*)')
SCENARIO_CAPABILITY = re.compile(r'^\s*#+\s*capability:', re.IGNORECASE)
# the behaviour scenarios whose transcripts wait for review, NAME<TAB>REASON
SCENARIO_PROVISIONAL = 'tools/conformance/scenarios/provisional.tsv'


class Table:
    """One TSV, kept as lines so only the tests cells change on a rewrite."""

    def __init__(self, path):
        self.path = path
        self.name = path.name
        text = path.read_text(encoding='utf-8')
        if not text.endswith('\n'):
            raise ValueError(f'{self.name}: the last line has no newline')
        lines = text[:-1].split('\n')
        self.header = lines[0].split('\t')
        for column in ('id', 'status', 'layer', 'tests'):
            if column not in self.header:
                raise ValueError(f'{self.name}: no `{column}` column')
        self.rows = []
        for number, line in enumerate(lines[1:], start=2):
            cells = line.split('\t')
            if len(cells) != len(self.header):
                raise ValueError(f'{self.name}:{number}: {len(cells)} cells, '
                                 f'the header has {len(self.header)}')
            self.rows.append((number, cells))
        self.is_modes = 'kind' in self.header and 'number' in self.header

    def cell(self, cells, column):
        return cells[self.header.index(column)]

    def render(self, tests_for):
        tests = self.header.index('tests')
        out = ['\t'.join(self.header)]
        for _, cells in self.rows:
            cells = list(cells)
            cells[tests] = ', '.join(tests_for(self.cell(cells, 'id')))
            out.append('\t'.join(cells))
        return '\n'.join(out) + '\n'


def check_feature_id(table, cells, row_id, where, errors):
    if not FEATURE_ID.fullmatch(row_id):
        errors.append(f'{where}: `{row_id}` is not a feature id (dotted lowercase words)')
        return
    family = row_id.split('.')[0]
    if family not in FAMILIES:
        errors.append(f'{where}: `{row_id}` has no known family; the first word is one of '
                      f'{", ".join(sorted(FAMILIES))}')
    elif family == 'osc' and table.cell(cells, 'group') != OSC_GROUP:
        errors.append(f'{where}: `{row_id}` is in the osc family outside the group "{OSC_GROUP}"')


def check_ids(tables, errors):
    """Every id well formed and unique; returns {id: (table, cells)}."""
    rows = {}
    for table in tables:
        for number, cells in table.rows:
            row_id = table.cell(cells, 'id')
            where = f'{table.name}:{number}'
            if table.is_modes:
                expect = f"{table.cell(cells, 'kind')}-{table.cell(cells, 'number')}"
                if not MODE_ID.fullmatch(row_id):
                    errors.append(f'{where}: `{row_id}` is not a mode id (ANSI-<n> or DEC-<n>)')
                elif row_id != expect:
                    errors.append(f'{where}: id `{row_id}` does not match kind and number `{expect}`')
            else:
                check_feature_id(table, cells, row_id, where, errors)
            if row_id in rows:
                errors.append(f'{where}: duplicate id `{row_id}`, first in {rows[row_id][0].name}')
                continue
            rows[row_id] = (table, cells)
    return rows


def tag_ids(text):
    return [part for part in re.split(r'[,\s]+', text.strip()) if part]


def read_tag(pattern, line, where, pending, errors):
    """Add a tag line's ids to pending; True when the line is a tag."""
    tag = pattern.match(line)
    if tag:
        ids = tag_ids(tag.group(1))
        if not ids:
            errors.append(f'{where}: a covers tag with no id')
        pending.extend((where, i) for i in ids)
        return True
    if NEAR_MISS.search(line):
        errors.append(f'{where}: `covers:` in a form the lint cannot read; write it as '
                      'a line comment holding only the tag')
    return False


def bracket_depth(text):
    return text.count('[') + text.count('(') - text.count(']') - text.count(')')


def scan_rust(path, rel, found, errors):
    lines = path.read_text(encoding='utf-8', errors='replace').split('\n')
    pending, is_test, depth = [], False, 0

    def unbound(why):
        errors.append(f'{pending[0][0]}: a covers tag {why}')

    for number, line in enumerate(lines, start=1):
        if read_tag(RUST_TAG, line, f'{rel}:{number}', pending, errors):
            continue
        if depth > 0:
            depth += bracket_depth(line)
            continue
        if not pending:
            continue
        stripped = line.strip()
        if not stripped or stripped.startswith(('//', '/*', '*')):
            continue
        if stripped.startswith('#['):
            is_test = is_test or bool(TEST_ATTR.match(stripped))
            depth = bracket_depth(stripped)
            continue
        fn = RUST_FN.match(line)
        if not fn:
            unbound('is not above a fn')
        elif not is_test:
            unbound(f'sits above fn {fn.group(1)}, which has no test attribute')
        else:
            for where, row_id in pending:
                found.append((row_id, f'{rel}::{fn.group(1)}', where))
        pending, is_test = [], False
    if pending:
        unbound('is not above a fn')


def provisional_scenarios(root, errors):
    """The names tools/conformance/scenarios/provisional.tsv lists, or none. A line that is not
    NAME, a tab and a reason is an error, as the conformance tool reads the list."""
    path = root / SCENARIO_PROVISIONAL
    if not path.is_file():
        return set()
    names = set()
    for number, line in enumerate(path.read_text(encoding='utf-8').split('\n'), start=1):
        if not line.strip() or line.startswith('#'):
            continue
        name, tab, reason = line.partition('\t')
        if not name or not tab or not reason.strip():
            errors.append(f'{SCENARIO_PROVISIONAL}:{number}: this line is not NAME, a tab and '
                          'a reason, so coverage cannot tell which scenario it lists')
            continue
        names.add(name)
    return names


def scan_scenario(path, rel, found, errors, provisional):
    """Add a scenario's tags to found, each naming the scenario's file. A tag of a scenario
    the provisional list names goes in with no test, so main checks its ids and counts it for
    no row."""
    lines = path.read_text(encoding='utf-8', errors='replace').split('\n')
    pending = []
    capability = None
    for number, line in enumerate(lines, start=1):
        where = f'{rel}:{number}'
        if SCENARIO_CAPABILITY.match(line):
            capability = where
        read_tag(SCENARIO_TAG, line, where, pending, errors)
    if pending and capability:
        errors.append(f'{pending[0][0]}: a capability scenario carries no covers tag; '
                      f'capabilities.list names its rows (its capability line is {capability})')
        return
    name = Path(rel).stem
    for where, row_id in pending:
        found.append((row_id, None if name in provisional else rel, where))


def scan(found, errors):
    """Read every tag in the repository's files; returns the count of each kind read.

    The files are the ones git tracks or would track: committed, staged, or new and
    not ignored. A build's output or an extracted copy (gitignored) is never
    read, so a tag in such a copy can't count toward vtium's coverage.
    """
    counts = {'.rs': 0, '.scenario': 0}
    provisional = provisional_scenarios(ROOT, errors)
    listed = subprocess.run(
        ['git', '-C', str(ROOT), 'ls-files', '-z', '--cached', '--others', '--exclude-standard'],
        capture_output=True, check=False)
    if listed.returncode != 0:
        sys.exit(f'coverage: git cannot list the files under {ROOT}: '
                 f'{listed.stderr.decode(errors="replace").strip()}')
    for rel in sorted(set(listed.stdout.decode().split('\0')) - {''}):
        suffix = os.path.splitext(rel)[1]
        if suffix not in counts:
            continue
        path = ROOT / rel
        if not path.is_file():
            continue
        counts[suffix] += 1
        if suffix == '.rs':
            scan_rust(path, rel, found, errors)
        else:
            scan_scenario(path, rel, found, errors, provisional)
    return counts


def stale_cells(tables, tests_for):
    """An error for each committed tests cell that differs from the tags."""
    errors = []
    for table in tables:
        for number, cells in table.rows:
            row_id = table.cell(cells, 'id')
            have, want = table.cell(cells, 'tests'), ', '.join(tests_for(row_id))
            if have != want:
                errors.append(f'{table.name}:{number}: `{row_id}` tests column is "{have}", '
                              f'the tags give "{want}" (run docs/scripts/coverage --update)')
    return errors


def write_tables(tables, tests_for):
    for table in tables:
        text = table.render(tests_for)
        if text != table.path.read_text(encoding='utf-8'):
            table.path.write_text(text, encoding='utf-8')
            print(f'coverage: rewrote {table.path.relative_to(ROOT)}')


# The one generator of COVERAGE.md is this test in tools/conformance/src/coverage.rs.
# With VTIUM_CONFORMANCE_BLESS set, the test writes the file before it compares it.
COVERAGE_MAP = 'tools/conformance/COVERAGE.md'
COVERAGE_TEST = 'coverage_map_matches_the_capability_list_and_adr_1000'
COVERAGE_CARGO = ['cargo', 'test', '-p', 'vtium-conformance', '--lib', COVERAGE_TEST]
# cargo prints this line when the filter ran exactly one test and it passed.
ONE_PASSED = re.compile(r'^test result: ok\. 1 passed;', re.MULTILINE)


def write_coverage_map(root=ROOT, cargo=COVERAGE_CARGO):
    """Regenerate COVERAGE.md under root by running its Rust test there with
    VTIUM_CONFORMANCE_BLESS=1. Returns 0, or 1 after printing cargo's output when cargo
    fails or runs no test. The tests of this script pass a stand-in for cargo."""
    rel = COVERAGE_MAP
    path = root / COVERAGE_MAP
    before = path.read_bytes() if path.is_file() else None
    command = ' '.join(COVERAGE_CARGO)
    print(f'coverage: regenerating {rel} with VTIUM_CONFORMANCE_BLESS=1 {command}', flush=True)
    env = dict(os.environ, VTIUM_CONFORMANCE_BLESS='1')
    try:
        run = subprocess.run(cargo, cwd=root, env=env, capture_output=True,
                             text=True, errors='replace', check=False)
    except OSError as err:
        print(f'coverage: cannot run cargo, so {rel} was not regenerated: {err}', file=sys.stderr)
        return 1
    output = run.stdout + run.stderr
    if run.returncode != 0 or not ONE_PASSED.search(run.stdout):
        sys.stderr.write(output)
        why = (f'cargo exited with status {run.returncode}' if run.returncode != 0
               else f'cargo ran no test named {COVERAGE_TEST}')
        print(f'coverage: {rel} was not regenerated, because {why}. '
              f'The tables are up to date. Fix the error above and run '
              f'docs/scripts/coverage --update again.', file=sys.stderr)
        return 1
    after = path.read_bytes() if path.is_file() else None
    if after != before:
        print(f'coverage: rewrote {rel}')
    return 0


# ADR-1000, "The target set": a mode whose note says this has no row in vtium's mode
# table, so DECRQM answers it 0 and no test drives it.
NOT_LISTED = "not in vtium's mode table"


def select_rows(rows, layer):
    """The rows whose layer column names LAYER (all without one), and those of them that need
    a test: every row but a mode whose note says it is not in vtium's mode table."""
    selected = list(rows.values())
    if layer:
        selected = [(t, c) for t, c in selected
                    if layer in [part.strip() for part in t.cell(c, 'layer').split(',')]]
    return selected, [(t, c) for t, c in selected if NOT_LISTED not in t.cell(c, 'note')]


def untested(counted, tests):
    return [f"{t.name}: `{t.cell(c, 'id')}` ({t.cell(c, 'status')}) has no test"
            for t, c in counted if not tests[t.cell(c, 'id')]]


def fail(errors, note=''):
    for error in errors:
        print(error, file=sys.stderr)
    print(f'coverage: {len(errors)} error(s){note}', file=sys.stderr)
    return 1


def main():
    parser = argparse.ArgumentParser(
        prog='coverage', description="Tie ADR-1000's tables to the tests that cover each row.")
    parser.add_argument('--update', action='store_true',
                        help='rewrite the tests columns from the tags, then regenerate '
                             'tools/conformance/COVERAGE.md through cargo')
    parser.add_argument('--layer', help='select the rows whose layer column names LAYER')
    parser.add_argument('--require', action='store_true',
                        help='fail while a selected row that needs a test has none')
    args = parser.parse_args()

    try:
        tables = [Table(path) for path in TABLES]
    except (OSError, ValueError) as err:
        print(f'coverage: {err}', file=sys.stderr)
        return 2

    errors = []
    rows = check_ids(tables, errors)
    found = []
    counts = scan(found, errors)
    if sum(counts.values()) == 0:
        print(f'coverage: no Rust or scenario files found under {ROOT}', file=sys.stderr)
        return 2

    tests = {row_id: set() for row_id in rows}
    for row_id, test, where in found:
        if row_id not in tests:
            errors.append(f'{where}: unknown id `{row_id}`')
        elif test is not None:
            tests[row_id].add(test)

    def tests_for(row_id):
        return sorted(tests.get(row_id, ()))

    if args.update:
        if errors:
            return fail(errors, '; the tables were not rewritten')
        write_tables(tables, tests_for)
        if write_coverage_map() != 0:
            return 1
    else:
        errors += stale_cells(tables, tests_for)

    selected, counted = select_rows(rows, args.layer)
    if not selected:
        print(f'coverage: no row has layer `{args.layer}`', file=sys.stderr)
        return 2
    if args.require:
        errors += untested(counted, tests)

    covered = sum(1 for t, c in counted if tests[t.cell(c, 'id')])
    scope = f'layer {args.layer}' if args.layer else 'all layers'
    waiting = sum(1 for _, test, _ in found if test is None)
    print(f"coverage: scanned {counts['.rs']} Rust and "
          f"{counts['.scenario']} scenario files, {len(found)} tags, {waiting} of them on "
          f"provisional scenarios, which do not count yet; "
          f'{scope}: {covered} of {len(counted)} rows that need a test have one')
    return fail(errors) if errors else 0


if __name__ == '__main__':
    sys.exit(main())
