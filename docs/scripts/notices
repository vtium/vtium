#!/usr/bin/env python3
"""
notices - check that COPYING names every generated table under crates/

Usage:
    docs/scripts/notices [--root DIR]

A generator writes some of vtium's tables from data that vtium did not
write, such as the Unicode Character Database or X.Org's rgb.txt. The data's
license travels with the generated file as a comment, but a binary built from
that file carries no comments, so COPYING names each generated table and the
license of its source (COPYING, "Per-File and Third-Party Notices").

This script finds every generated table: a file under crates/ whose first 12
lines hold a comment that says "Generated by" or "Generated from", the way
each generator heads its output. It prints `file:line: text` for each table
whose path COPYING does not name, and exits 1 if it finds any. It exits 0
when COPYING names them all, and 2 when it finds no COPYING or no generated
table at all, so a wrong root never passes.

It skips Cargo.lock files, which cargo writes and which say they are
generated, and the directories cargo and the fuzzers write: target, and a
fuzz target's corpus and artifacts.

--root DIR reads DIR instead of this checkout, for example a copy of the
tree with a defect planted in it.
"""

import argparse
import os
import re
import sys

# A comment line, in Rust (//, //!, ///, /* or a * continuation) or in a
# shell or text file (#), that says the file is generated.
GENERATED = re.compile(r"^\s*(//[/!]?|/\*|\*|#).*\bGenerated (by|from)\b")

HEAD_LINES = 12

SKIP_DIRS = {"target", ".git", "corpus", "artifacts"}

SKIP_FILES = {"Cargo.lock"}


def generated_tables(root):
    """Yield (relative path, line number, line) for each generated table."""
    crates = os.path.join(root, "crates")
    for dirpath, dirnames, filenames in os.walk(crates):
        dirnames[:] = sorted(d for d in dirnames if d not in SKIP_DIRS)
        for name in sorted(filenames):
            if name in SKIP_FILES:
                continue
            path = os.path.join(dirpath, name)
            try:
                with open(path, "rb") as f:
                    head = f.read(8192)
            except OSError:
                continue
            if b"\0" in head:
                continue
            text = head.decode("utf-8", errors="replace")
            for number, line in enumerate(text.splitlines()[:HEAD_LINES], 1):
                if GENERATED.search(line):
                    yield os.path.relpath(path, root), number, line.strip()
                    break


def main():
    parser = argparse.ArgumentParser(
        description="check that COPYING names every generated table under crates/"
    )
    parser.add_argument(
        "--root",
        default=os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", ".."),
        help="the tree to read (default: this checkout)",
    )
    args = parser.parse_args()
    root = os.path.normpath(args.root)

    try:
        with open(os.path.join(root, "COPYING"), encoding="utf-8") as f:
            copying = f.read()
    except OSError as error:
        print(f"notices: cannot read COPYING under {root}: {error}", file=sys.stderr)
        return 2
    named = {word.rstrip(".") for word in re.findall(r"[\w./-]+", copying)}

    tables = list(generated_tables(root))
    if not tables:
        print(f"notices: no generated table under {root}/crates", file=sys.stderr)
        return 2

    missing = [t for t in tables if t[0] not in named]
    for path, number, line in missing:
        print(f"{path}:{number}: {line}")
    if missing:
        print(
            f"notices: COPYING names {len(tables) - len(missing)} of {len(tables)} "
            "generated tables; add a paragraph for each table above, naming its "
            "source and that source's license",
            file=sys.stderr,
        )
        return 1
    print(f"notices: COPYING names all {len(tables)} generated tables")
    return 0


if __name__ == "__main__":
    sys.exit(main())
