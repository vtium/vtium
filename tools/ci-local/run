#!/usr/bin/env bash
# run - run the workspace's tests in a container that matches CI's runner
#
# Usage:
#
#     make ci-local [BUILDS='all-features default'] [TEST_ARGS='-p CRATE ...']
#     tools/ci-local/run [--builds 'all-features default'] [CARGO ARGS...]
#
# CI's check jobs run on GitHub's ubuntu-latest runner, Ubuntu 24.04, where
# /bin/sh is dash and bash, coreutils and the other tools are older than this
# machine's. A test can pass here and fail there. This script runs the
# workspace's tests as CI's check jobs do, with --all-features and without:
# `cargo nextest run --workspace --no-fail-fast`, then the doctests with
# `cargo test --doc --workspace`, since nextest runs no doctests. They run
# inside a container built from Ubuntu 24.04 with the packages, the Rust
# toolchain and the cargo-nextest version CI installs (Containerfile, beside
# this script). Both commands run to the end, so one failing test binary
# never hides another.
#
# It uses podman when installed, docker otherwise, and stops when neither is.
# The image, cargo's registry and a target directory for each worktree are
# cached under $XDG_CACHE_HOME/vtium/ci-local. The worktree is mounted
# read-only, and its files, those git tracks plus untracked ones it does not
# ignore, are copied into the container before each build, so the run never
# changes the worktree. Each build's output goes to a log in the cache.
#
# The last line printed says whether every build passed, or names the tests
# that failed in each build. The script exits 0 when every build passed, 1
# when one failed, and 2 when it could not run.

set -euo pipefail

here=$(cd "$(dirname "$0")" && pwd)
root=$(cd "$here/../.." && pwd)
builds='all-features default'
if [[ ${1-} == --builds ]]; then
    builds=$2
    shift 2
fi
for b in $builds; do
    case $b in
        all-features | default) ;;
        *) echo "ci-local: $b is not a build. The builds are all-features and default." >&2; exit 2 ;;
    esac
done

if command -v podman >/dev/null; then
    rt=podman
    # Rootless podman maps the user to root in the container unless told to
    # keep the user's own uid there.
    rt_user=(--userns=keep-id)
elif command -v docker >/dev/null; then
    rt=docker
    rt_user=()
else
    echo "ci-local: neither podman nor docker is installed, so the tests cannot run in a container." >&2
    exit 2
fi

cache=${XDG_CACHE_HOME:-$HOME/.cache}/vtium/ci-local
toolchain=$(sed -n 's/^channel = "\(.*\)"$/\1/p' "$root/rust-toolchain.toml")
nextest=$(sed -n 's/^NEXTEST_VERSION *= *//p' "$root/Makefile")
[[ -n $nextest ]] || { echo "ci-local: the Makefile names no NEXTEST_VERSION, so the image cannot install cargo-nextest." >&2; exit 2; }
uid=$(id -u)
gid=$(id -g)
# The tag changes with the Containerfile, the toolchain, cargo-nextest's
# version and the user, so a change to any of them builds a new image.
recipe=$(sha256sum "$here/Containerfile" | cut -c1-12)
image=localhost/vtium-ci-local:$toolchain-nextest-$nextest-$recipe-$uid
# One target directory for each worktree: cargo decides what to rebuild from
# file times, so two worktrees whose sources differ must never share one.
tree=$(printf '%s' "$root" | sha256sum | cut -c1-16)
target=$cache/target/$tree
logs=$cache/logs/$tree
mkdir -p "$cache/registry" "$cache/git" "$target" "$logs"

if ! $rt image inspect "$image" >/dev/null 2>&1; then
    echo "ci-local: building the image $image with $rt"
    $rt build -t "$image" -f "$here/Containerfile" \
        --build-arg UID="$uid" --build-arg GID="$gid" --build-arg TOOLCHAIN="$toolchain" \
        --build-arg NEXTEST_VERSION="$nextest" \
        "$here" || { echo "ci-local: the image did not build." >&2; exit 2; }
fi

# The files a checkout of this tree would hold: the tracked ones that exist,
# and the untracked ones git does not ignore. Directories, which a submodule
# leaves in the list, are left out; CI's checkout leaves submodules empty.
list=$logs/files
(cd "$root" && git ls-files -z --cached --others --exclude-standard | sort -zu |
    while IFS= read -r -d '' f; do
        if [[ -L $f || -f $f ]]; then printf '%s\0' "$f"; fi
    done) >"$list"

src=/home/runner/work/vtium/vtium
# CI's runner is a virtual machine, so it has the VT devices /dev/tty0 to
# /dev/tty63, and some tests stat one to read its VT number. The container
# starts as root only to make those device nodes; the container's device
# rules refuse every open of them, so no test can reach this machine's VTs.
# Rootless podman cannot make device nodes, and those tests then fail. The
# runner's user also has a runtime directory, /run/user/UID, which
# XDG_RUNTIME_DIR names and where vtium-config keeps its private folders, so
# the container makes one too. The
# step then drops to the runner user, copies the files into the container's
# own layer, keeping their times so that cargo reuses what it built before,
# and runs the tests there as CI's steps do, with bash -e.
step='tar -C /src --null -T /home/runner/files -cf - | tar -C "$PWD" -xf - && { s=0; cargo nextest run --workspace --no-fail-fast "$@" || s=1; cargo test --doc --workspace "$@" || s=1; exit $s; }'
entry='for n in $(seq 0 63); do mknod -m 620 /dev/tty$n c 4 $n 2>/dev/null || true; done
mkdir -p "/run/user/$1" && chown "$1:$2" "/run/user/$1" && chmod 700 "/run/user/$1"
export XDG_RUNTIME_DIR="/run/user/$1"
exec setpriv --reuid="$1" --regid="$2" --init-groups --inh-caps=-all --bounding-set=-all bash -e -c "$3" "${@:4}"'

failed=()
start=$SECONDS
for b in $builds; do
    flags=()
    [[ $b == all-features ]] && flags=(--all-features)
    log=$logs/$b.log
    echo "ci-local: cargo nextest run --workspace ${flags[*]} --no-fail-fast $*, then the doctests (Ubuntu 24.04, Rust $toolchain, cargo-nextest $nextest, $rt)"
    t0=$SECONDS
    set +e
    # Docker and podman add a seccomp filter of their own to each process,
    # and CI's runner adds none; one test counts a process's filters, so the
    # container runs without that outer filter.
    $rt run --rm --init "${rt_user[@]}" --user 0 --security-opt seccomp=unconfined --shm-size=2g \
        -e HOME=/home/runner -e USER=runner \
        -v "$root:/src:ro" -v "$list:/home/runner/files:ro" \
        -v "$cache/registry:/home/runner/.cargo/registry" -v "$cache/git:/home/runner/.cargo/git" \
        -v "$target:$src/target" -w "$src" "$image" \
        bash -c "$entry" entry "$uid" "$gid" "$step" bash "${flags[@]}" "$@" 2>&1 | tee "$log"
    status=${PIPESTATUS[0]}
    set -e
    echo "ci-local: $b took $(((SECONDS - t0) / 60))m$(((SECONDS - t0) % 60))s and exited $status; its log is $log"
    if ((status != 0)); then
        # The names of the failed tests: nextest names each as the crate,
        # the test binary and the test, and a failed doctest follows its
        # crate's Doc-tests line. When cargo failed before it ran a test, as
        # when a crate does not compile, the summary names what cargo said
        # instead.
        names=$(sed 's/\x1b\[[0-9;]*m//g' "$log" | awk '
            /^ *Running / { bin = $NF; sub(/^\(/, "", bin); sub(/\)$/, "", bin); n = split(bin, p, "/"); bin = p[n]; sub(/-[0-9a-f]+$/, "", bin) }
            /^ *Doc-tests / { bin = $2 " doc" }
            /^ *(FAIL|TIMEOUT|SIGSEGV|SIGABRT) \[/ { t = $0; sub(/^ *[A-Z]+ \[[^]]*\] +(\([^)]*\) +)?/, "", t); if (!(t in seen)) { seen[t] = 1; out = out (out == "" ? "" : ", ") t } }
            /^test .* \.\.\. FAILED$/ { t = $0; sub(/^test /, "", t); sub(/ \.\.\. FAILED$/, "", t); k = bin "::" t; if (!(k in seen)) { seen[k] = 1; out = out (out == "" ? "" : ", ") k } }
            /^error: could not compile / { k = $0; sub(/^error: /, "", k); if (!(k in seen)) { seen[k] = 1; out = out (out == "" ? "" : ", ") k } }
            END { print out }')
        failed+=("$b: ${names:-the tests exited $status}")
    fi
done

took="$(((SECONDS - start) / 60))m$(((SECONDS - start) % 60))s"
if ((${#failed[@]} == 0)); then
    echo "ci-local: passed ($builds) in $took"
else
    summary=$(printf '%s; ' "${failed[@]}")
    echo "ci-local: FAILED in $took: ${summary%; }"
    exit 1
fi
