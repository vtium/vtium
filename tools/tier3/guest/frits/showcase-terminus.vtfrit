# tier 3's showcase fonts scene, the bitmap band: Terminus's ter-v32n PSF,
# 16x32 cells, from Arch Linux's terminus-font package (t3_showcase.py),
# then the built-in GNU Unifont for anything it lacks. Its own cell is
# stated so the console never waits on the helper for it (ADR-1200 D17).
name=showcase-terminus
license=OFL-1.1
source=file:/usr/local/share/fonts/vtium-showcase/ter-v32n.psf.gz
source=builtin:unifont
cell=16x32
