# tier 3's heads-two-heads look of the head panel (guest/heads/two-heads.conf):
# tools/testfont's 8x8 PSF2 font, with the built-in Unscii-8 filling the
# characters it lacks. Its cell is stated, so the console never waits on the
# helper for the fonts' own (ADR-1200 D17).
source=file:/usr/local/share/tier3-fonts/vtium-test-8x8.psf
source=builtin:unscii-8
cell=8x8
