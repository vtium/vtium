# tier 3's heads-two-heads profile of the head desk (guest/heads/two-heads.conf):
# tools/testfont's 8x16 PSF1 font, with the built-in unifont filling the
# characters it lacks. Its cell is stated, so the console never waits on the
# helper for the fonts' own (ADR-1200 D17).
source=file:/usr/local/share/tier3-fonts/vtium-test-8x16.psf
source=builtin:unifont
cell=8x16
