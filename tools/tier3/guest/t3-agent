#!/bin/bash
# The head-file variants' agent (t3_heads.py), run as root by t3-agent.service
# in a guest whose console gives no login. It reads one request a line from
# the third serial port, ttyS2, which the driver reaches over a unix socket,
# and answers on the same port, which only root can open, so no other program
# in the guest can forge an answer: each line of the answer to request N is
# "T3-AGENT N ...", and "T3-AGENT-END N" ends it. Its few requests:
#   state            the units of VT 2, when each getty that could run on
#                    tty2 last left its inactive state and how often it
#                    restarted, the jobs and timers systemd has, the login
#                    sessions and their ttys, the getty marker, the programs
#                    on tty2, the logins, the VT shown, the PS/2 keyboard's
#                    and the USB controller's interrupts, the keyboards the
#                    guest lists, the key presses the second keyboard sent
#                    once watched, and the PID and age of vtium on tty2, one
#                    line each
#   watch            counts the key presses of the keyboard in the USB hub's
#                    port 3.3, the kiosk's second keyboard, read from its own
#                    evdev node, until it is pulled out
#   kill SIGNAL      sends SIGNAL to vtium on tty2, its unit's main process
#                    (KILL, a kill; ABRT, a crash)
#   hangup           hangs tty2 up, as the kernel's vhangup does
#   start            starts vtium's unit on tty2 again
#   restart          restarts vtium's unit on tty2, as after an upgrade
#   stop             stops vtium's unit on tty2
#   ptys             each process that leads a session on a pty, with the
#                    pty and its size; how many pty masters vtium on tty2
#                    holds; and each answer a line typed in a session wrote
#                    to /tmp/t3-answer-WHAT (the session-survives check)
#   reset-failed     clears the failed state and start count of vtium's unit
#   limit            sends SIGKILL to each new vtium on tty2 until its unit
#                    stops restarting, and once the unit failed on its start
#                    limit, starts it once more
#   kmsg             makes the kernel log an error of its own: a mount of
#                    tmpfs through the old mount(2) call with the unknown
#                    option vtium_tier3_warning, which the kernel refuses
#                    with "tmpfs: Unknown parameter 'vtium_tier3_warning'"
#                    at level err (t3_seat.py's kernel-message case)
#   panic            crashes the kernel with echo c > /proc/sysrq-trigger,
#                    once its answer is written (t3_seat.py's panic case)
#   prelogin         writes two kitty pictures to the pty of the login prompt
#                    on tty2, as a program there would, before anyone logs in
#                    (the images variants, t3_images.py), then reports the
#                    pty's owner and the account each image helper runs as
# Any other request, spelled even one character differently, answers
# "T3-AGENT N refused REQUEST" and runs nothing. T3_AGENT_PORT names another
# port, as the harness's self-test does with a pty.
set -u
port=${T3_AGENT_PORT:-/dev/ttyS2}
vt=tty2
units=("vtium@$vt.service" "vtium-getty@$vt.service" "getty@$vt.service")
# The gettys the guest could start on tty2. autovt@tty2 is not one: in this
# guest it is vtium's unit, through the template link that vtium console
# enable --all makes (guest/setup).
gettys=("getty@$vt.service" "serial-getty@$vt.service")
# The kiosk's second keyboard, which t3_devices plugs into the hub's port
# 3.3, and the count of its key presses that `watch` keeps.
second=/dev/input/by-path/pci-0000:15:00.0-usb-0:3.3:1.0-event-kbd
keys=/run/t3-agent/second.keys

# The PID of vtium on tty2, its unit's main process, and its age in seconds,
# from its start time in clock ticks against the guest's uptime; none when
# the unit runs nothing.
vtium_age() {
    local pid
    pid=$(systemctl show -P MainPID "${units[0]}")
    [ "${pid:-0}" != 0 ] || return 0
    awk -v pid="$pid" -v hz="$(getconf CLK_TCK)" '
        NR == FNR { up = $1; next }
        { sub(/^.*\) /, ""); printf "vtium %s %.1f\n", pid, up - $20 / hz }
    ' /proc/uptime "/proc/$pid/stat"
}

# The interrupts so far of the lines of /proc/interrupts that awk's test
# `$1` selects, summed over the CPUs.
interrupts() {
    awk "$1"' { for (i = 2; i <= NF && $i ~ /^[0-9]+$/; i++) n += $i } END { print n + 0 }' \
        /proc/interrupts
}

state() {
    local u link words
    echo "systemd $(systemctl --version | awk 'NR == 1 { print $2 }')"
    for u in "${units[@]}"; do
        echo "unit $u $(systemctl show -P ActiveState "$u") $(systemctl show -P Result "$u")" \
            "$(systemctl show -P ConditionResult "$u") $(systemctl show -P ConditionTimestampMonotonic "$u")"
        echo "restarts $u $(systemctl show -P SubState "$u") $(systemctl show -P NRestarts "$u")"
    done
    # What systemd logged this boot of vtium's unit and its fallback, in
    # order, a word each: a restart clears Result=, so only the journal
    # keeps each failure's result, and only the journal shows each time the
    # fallback skipped itself, where the condition's timestamp shows the
    # last.
    words=$(journalctl -b -q -o cat -u "${units[0]}" -u "${units[1]}" | sed -n \
        -e "s/^${units[0]}: Failed with result '\([a-z-]*\)'\.$/failed:\1/p" \
        -e "s/^${units[0]}: Scheduled restart job, restart counter is at \([0-9]*\)\.$/restart:\1/p" \
        -e "s/^Started vtium on $vt\.$/started/p" \
        -e "s/^Stopped vtium on $vt\.$/stopped/p" \
        -e "s/^getty in place of vtium on $vt skipped, unmet condition check .*$/skipped/p" \
        -e "s/^Finished getty in place of vtium on $vt\.$/fell-back/p" | tr '\n' ' ')
    echo "journal ${words% }"
    # A getty that started and ended between two requests leaves these set.
    for u in "${gettys[@]}"; do
        echo "getty $u $(systemctl show -P InactiveExitTimestampMonotonic "$u")" \
            "$(systemctl show -P NRestarts "$u")"
    done
    # Every job systemd has queued, and every timer with its state, which a
    # start delayed by a timer waits in, one line each.
    systemctl list-jobs --no-legend | awk '{ print "job", $2, $3, $4 }'
    systemctl list-units --all --type=timer --no-legend --plain | awk '{ print "timer", $1, $4 }'
    for u in $(loginctl list-sessions --no-legend | awk '{ print $1 }'); do
        echo "session $u $(loginctl show-session -P TTY "$u")"
    done
    if [ -e "/run/vtium/$vt.closed" ]; then echo "marker yes"; else echo "marker no"; fi
    echo "tty2 $(ps -t "$vt" -o comm= | tr '\n' ' ')"
    echo "logins $(pgrep -c -x login)"
    echo "fgconsole $(fgconsole)"
    echo "i8042 $(interrupts '$1 == "1:"')"
    echo "xhci $(interrupts '/xhci_hcd/')"
    udevadm settle --timeout=10
    for link in /dev/input/by-path/*-event-kbd; do
        [ -e "$link" ] && echo "kbd ${link##*/}"
    done
    [ -e "$keys" ] && echo "keys $(cat "$keys")"
    vtium_age
}

# Fails vtium on tty2 past its unit's start limit: sends SIGKILL to each new
# vtium its unit runs, at most 12 times, until the unit stops restarting,
# that is until it is failed or inactive and not waiting to restart. Each
# wait for the next vtium is bounded at 10 s. When the unit failed on its
# start limit, it then starts the unit once more, at once, so within the
# limit's 10 s window, and reports whether systemd refused that start.
limit() {
    local u=${units[0]} last=0 pid kills=0 active sub
    while [ "$kills" -lt 12 ]; do
        pid=0
        for _ in $(seq 100); do
            pid=$(systemctl show -P MainPID "$u")
            active=$(systemctl show -P ActiveState "$u")
            sub=$(systemctl show -P SubState "$u")
            [ "${pid:-0}" != 0 ] && [ "$pid" != "$last" ] && break
            pid=0
            case "$active $sub" in
                "failed failed" | "inactive dead") break ;;
            esac
            sleep 0.1
        done
        [ "$pid" != 0 ] || break
        kill -s KILL "$pid" && echo "sent KILL to $pid"
        last=$pid
        kills=$((kills + 1))
    done
    echo "stopped $(systemctl show -P ActiveState "$u") $(systemctl show -P SubState "$u")" \
        "$(systemctl show -P Result "$u") after $kills kills"
    if [ "$(systemctl show -P Result "$u")" = start-limit-hit ]; then
        if systemctl start "$u" > /dev/null 2>&1; then echo "start ran"; else echo "start refused"; fi
    fi
}

# The sessions on ptys (ADR-1401 D13): each process that leads a session
# whose controlling terminal is a pty, its pty and the pty's size in
# columns and rows, read without making the pty the agent's controlling
# terminal; the pty masters vtium on tty2 has open; and each answer a
# session wrote to /tmp/t3-answer-WHAT, one line each.
ptys() {
    local p t c pid f
    ps -eo pid=,sid=,tty=,comm= | awk '$1 == $2 && $3 ~ /^pts\// { print $1, $3, $4 }' |
        while read -r p t c; do
            echo "pty $p $t $(python3 -I -c '
import fcntl, os, struct, sys, termios
fd = os.open(sys.argv[1], os.O_RDONLY | os.O_NOCTTY | os.O_NONBLOCK)
rows, cols, _, _ = struct.unpack("HHHH", fcntl.ioctl(fd, termios.TIOCGWINSZ, bytes(8)))
print("%dx%d" % (cols, rows))
' "/dev/$t") $c"
        done
    pid=$(systemctl show -P MainPID "${units[0]}")
    if [ "${pid:-0}" != 0 ]; then
        echo "masters $pid $(find "/proc/$pid/fd" -lname '*ptmx' 2>/dev/null | wc -l)"
    fi
    for f in /tmp/t3-answer-*; do
        [ -e "$f" ] && echo "answer ${f#/tmp/t3-answer-} $(head -c 64 "$f")"
    done
}

# The images variants' pictures before login (ADR-1101 D2, D10): the
# quarters PNG read from a file (t=f) at row 12, column 5, which vtium must
# refuse while the pty's owner is root, and the same PNG sent inline at
# column 25, which the image helper decodes as vtium-image, or as nobody
# when that account is gone. Both carry q=2, so no reply reaches the login
# prompt's input; the cursor is saved and restored around them. Then the
# owner of the pty, and the account of each process running
# /usr/bin/vtium-image, waiting up to 5 s for the first.
prelogin() {
    local pts pics=/usr/local/share/tier3/pictures p users=
    pts=$(ps -C login -o tty= | awk 'NR == 1 { print $1 }')
    if [ -z "$pts" ] || [ ! -c "/dev/$pts" ]; then
        echo "refused: no login prompt on a pty"
        return
    fi
    {
        printf '\e7\e[12;5H\033_Ga=T,i=91,q=2,C=1,f=100,t=f;%s\033\\' \
            "$(printf %s "$pics/quad.png" | base64 -w0)"
        printf '\033[12;25H\033_Ga=T,i=92,q=2,C=1,f=100;%s\033\\\e8' \
            "$(base64 -w0 "$pics/quad.png")"
    } > "/dev/$pts"
    echo "pty /dev/$pts $(stat -c %U "/dev/$pts")"
    for _ in $(seq 50); do
        for p in /proc/[0-9]*; do
            [ "$(readlink "$p/exe" 2>/dev/null)" = /usr/bin/vtium-image ] \
                && users+=" $(stat -c %U "$p")"
        done
        [ -n "$users" ] && break
        sleep 0.1
    done
    echo "helpers${users:- none}"
}

answer() {
    local n=$1 request=$2 pid
    case "$request" in
        state) state ;;
        "kill KILL" | "kill ABRT")
            pid=$(systemctl show -P MainPID "${units[0]}")
            if [ "${pid:-0}" = 0 ]; then
                echo "refused: ${units[0]} runs no process"
            else
                kill -s "${request#kill }" "$pid" && echo "sent ${request#kill } to $pid"
            fi
            ;;
        # TIOCVHANGUP, 0x5437: the call systemd's TTYVHangup= makes.
        hangup)
            python3 -I -c 'import fcntl, os; fd = os.open("/dev/tty2", os.O_RDWR | os.O_NOCTTY); fcntl.ioctl(fd, 0x5437)' \
                && echo "hung up /dev/$vt"
            ;;
        start) systemctl start --no-block "${units[0]}" && echo "started ${units[0]}" ;;
        restart) systemctl restart --no-block "${units[0]}" && echo "restarted ${units[0]}" ;;
        stop) systemctl stop --no-block "${units[0]}" && echo "stopped ${units[0]}" ;;
        ptys) ptys ;;
        reset-failed)
            systemctl reset-failed "${units[0]}" && echo "reset ${units[0]}"
            ;;
        limit) limit ;;
        prelogin) prelogin ;;
        panic) echo "crashing the kernel" ;;
        # A line written to /dev/kmsg is logged with the user facility,
        # which vtium does not show, so the kernel itself must log the
        # message. mount(8) passes options through fsconfig(2), whose
        # errors go back to the caller and not to the kernel's log, so
        # the call is mount(2) itself.
        kmsg)
            mkdir -p /run/t3-kmsg
            python3 -I -c '
import ctypes, os
libc = ctypes.CDLL(None, use_errno=True)
r = libc.mount(b"none", b"/run/t3-kmsg", b"tmpfs", 0, b"vtium_tier3_warning")
print("mount %d %s" % (r, os.strerror(ctypes.get_errno()) if r else "mounted"))
'
            ;;
        # A reader of the second keyboard's evdev node, apart from the agent
        # and its port, which ends when the keyboard is pulled out; the
        # answer comes once it has opened the node and counted none.
        watch)
            mkdir -p "${keys%/*}" && rm -f "$keys"
            python3 -I -c '
import os, struct, sys
fd, out, n = os.open(sys.argv[1], os.O_RDONLY), sys.argv[2], 0
event = struct.Struct("llHHi")  # struct input_event: time, type, code, value
def put():
    with open(out + ".new", "w") as f:
        f.write("%d\n" % n)
    os.replace(out + ".new", out)
put()
while True:
    try:
        data = os.read(fd, event.size * 64)
    except OSError:
        break
    if not data:
        break
    # EV_KEY, 1, with the value 1 of a press
    n += sum(1 for _, _, t, _, v in event.iter_unpack(data) if t == 1 and v == 1)
    put()
' "$second" "$keys" < /dev/null > /dev/null 2>&1 3>&- &
            for _ in $(seq 50); do
                [ -e "$keys" ] && break
                sleep 0.2
            done
            if [ -e "$keys" ]; then echo "watching $second"; else echo "refused: $second unread"; fi
            ;;
        *) echo "refused $request" ;;
    esac 2>&1 | while IFS= read -r line; do echo "T3-AGENT $n $line"; done
    echo "T3-AGENT-END $n"
}

exec 3<> "$port"
stty raw -echo clocal 115200 <&3
while IFS= read -r line <&3; do
    line=${line%$'\r'}
    n=${line%% *}
    [ -n "$n" ] && [ "$n" != "$line" ] || continue
    answer "$n" "${line#* }" >&3
    # The kernel panics once the answer is on the port: the driver reads it,
    # then watches the console and the screen for the panic.
    if [ "${line#* }" = panic ]; then
        sync
        echo c > /proc/sysrq-trigger
    fi
done
