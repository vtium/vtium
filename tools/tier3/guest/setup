#!/bin/sh
# Per-run guest setup, run as root at boot from the T3PKG disc mounted at $1:
# unpacks vtium's install tree (tree.tar) over the root, installs the
# variant's config, its test fonts, its frits and the scenario screens.
set -eu
disc=$1
tar -xpf "$disc"/tree.tar -C / --no-overwrite-dir --keep-directory-symlink
tree=$(sha256sum "$disc"/tree.tar | cut -d' ' -f1)
# A variant naming features runs vtium built with them in place of the
# tree's binary.
if [ -f "$disc"/vtium ]; then
    install -m755 "$disc"/vtium /usr/bin/vtium
fi
install -Dm644 "$disc"/vtium.conf /etc/vtium/vtium.conf
# A tree whose console is built with images holds the image helper and its
# sysusers file, from which systemd-sysusers makes the helper's account for
# the login prompt, as a package's install hook runs it (ADR-1101 D2). The
# report line gives the helper's mode and the account's ids.
images=none
if [ -f /usr/lib/sysusers.d/vtium-image.conf ]; then
    if ! out=$(systemd-sysusers /usr/lib/sysusers.d/vtium-image.conf 2>&1); then
        printf 'TIER3-INSTALL-FAIL systemd-sysusers: %s\n' "$out" > /dev/ttyS0
        exit 1
    fi
    images="helper /usr/bin/vtium-image mode $(stat -c %a /usr/bin/vtium-image), account"
    images="$images vtium-image uid $(id -u vtium-image) gid $(id -g vtium-image)"
    # A variant whose helper runs as nobody before login removes the account
    # again, as an administrator might, before vtium starts (ADR-1101 D2).
    if [ -f "$disc"/no-image-account ]; then
        userdel vtium-image
        if getent group vtium-image > /dev/null; then groupdel vtium-image; fi
        if id vtium-image > /dev/null 2>&1; then
            printf 'TIER3-INSTALL-FAIL the account vtium-image is still there\n' > /dev/ttyS0
            exit 1
        fi
        images="${images%%, account*}, account vtium-image removed"
    fi
fi
# A variant drawing with the test fonts names them in its config.
if [ -d "$disc"/fonts ]; then
    install -Dm644 -t /usr/local/share/tier3-fonts "$disc"/fonts/*
fi
# A variant drawing a PSF font installs its frits, whose glyphs the helper
# generates at run time (ADR-1301 D2); nothing is built before the console
# starts.
if [ -d "$disc"/frits ]; then
    install -Dm644 -t /etc/vtium/fonts "$disc"/frits/*.vtfrit
fi
# A variant whose font is a frit generated at run time installs it with no
# set built (ADR-1301 D2). One that holds the helper replaces vtium-config
# with a program that never answers, so the screens show what the console
# draws before any answer.
if [ -d "$disc"/deferred-frits ]; then
    install -Dm644 -t /etc/vtium/fonts "$disc"/deferred-frits/*.vtfrit
fi
if [ -f "$disc"/helper-held ]; then
    printf '#!/bin/sh\nexec /usr/bin/sleep 3600\n' > /usr/bin/vtium-config
    chmod 755 /usr/bin/vtium-config
fi
# The pointer variant's screens read the display's DRM atomic state as
# tester (screens/pointer.sh), so debugfs is opened to them.
if [ -f "$disc"/pointer ]; then
    mountpoint -q /sys/kernel/debug || mount -t debugfs debugfs /sys/kernel/debug
    chmod 0755 /sys/kernel/debug
fi
# The udev-examples variant installs the example hwdb fragment as an
# administrator would, its token's match changed to a device the guest has,
# the PS/2 keyboard (bus 0011, vendor 0001, product 0001), so udev's own
# 60-evdev.rules reads the fragment for that keyboard.
if [ -f "$disc"/udev-examples ]; then
    install -d /etc/udev/hwdb.d
    sed 's/^evdev:input:b0003vBBBBp0001\*$/evdev:input:b0011v0001p0001*/' \
        /usr/share/doc/vtium/examples/vtium.hwdb > /etc/udev/hwdb.d/vtium.hwdb
    grep -qx 'evdev:input:b0011v0001p0001\*' /etc/udev/hwdb.d/vtium.hwdb
    systemd-hwdb update
fi
# A variant whose img-png screen reads a file on rpc_pipefs mounts it as
# root, which the screen's user cannot, and lets everyone read its one
# regular file, so only the image helper's refusal of the filesystem keeps
# the file from being read (ADR-1101 D5, D10).
if [ -f "$disc"/rpc-pipefs ]; then
    if ! out=$({ modprobe sunrpc && mkdir -p /run/t3-rpc \
                 && mount -t rpc_pipefs rpc_pipefs /run/t3-rpc \
                 && chmod 0444 /run/t3-rpc/gssd/clntXX/info; } 2>&1); then
        printf 'TIER3-INSTALL-FAIL rpc_pipefs: %s\n' "$out" > /dev/ttyS0
        exit 1
    fi
fi
# A power variant's kernel settings, such as kernel.ctrl-alt-del for the
# hard reboot, set before the console starts.
if [ -f "$disc"/sysctl.conf ]; then
    sysctl -q -p "$disc"/sysctl.conf
fi
# A head-file variant installs its head file as an administrator would,
# root's and written by no one else, which the start's ownership check
# trusts (ADR-1401 D7).
if [ -f "$disc"/heads.conf ]; then
    install -Dm644 -o root -g root "$disc"/heads.conf /etc/vtium/heads.conf
fi
# A variant whose console may give no login runs the agent (t3-agent), which
# answers the driver's requests on the event port as root.
if [ -f "$disc"/t3-agent ]; then
    install -m755 "$disc"/t3-agent /usr/local/sbin/t3-agent
    install -m644 "$disc"/t3-agent.service /etc/systemd/system/t3-agent.service
fi
# The console's log also goes to the serial console, so the harness can read
# which video backend and text renderer drew the screens.
mkdir -p /etc/systemd/system/vtium@.service.d
printf '[Service]\nStandardOutput=journal+console\nStandardError=journal+console\n' \
    > /etc/systemd/system/vtium@.service.d/tier3.conf
# vtium takes the guest's VTs the way a user gives them to it. The base
# image, provisioned by the C reference's guest file (user-data.in), links
# autovt@.service, the unit logind starts on a VT the driver switches to, to
# kmsconvt@.service, a unit no vtium install has. setup first links it back
# to getty@.service, where Arch's systemd package links it. vtium console
# enable --all then links it to vtium@.service, recording the getty. It
# changes only what starts next, and the boot's units are already queued, so
# tty1 keeps its getty and logind starts vtium on tty2 at the driver's
# switch.
ln -sfn /usr/lib/systemd/system/getty@.service /etc/systemd/system/autovt@.service
if ! out=$(vtium console enable --all 2>&1); then
    printf 'TIER3-INSTALL-FAIL vtium console enable --all: %s\n' "$out" > /dev/ttyS0
    exit 1
fi
systemctl daemon-reload
rm -rf /usr/local/share/tier3
cp -r "$disc"/screens /usr/local/share/tier3
install -m755 "$disc"/t3 /usr/local/bin/t3
# ttyS1 is the harness's event port: the scenario reports a login and each
# drawn screen there, and the driver waits for those lines.
stty -F /dev/ttyS1 clocal
chmod 0666 /dev/ttyS1
echo 'echo "T3-LOGIN $(tty)" > /dev/ttyS1' > /etc/profile.d/tier3.sh
if [ -f /etc/systemd/system/t3-agent.service ]; then
    systemctl start --no-block t3-agent.service
fi
# Any kmscon, libtsm or vtium package installed, which must be none; the
# kernel the guest runs, which the report records; the image helper and its
# account; and the tree unpacked, so the log shows which build drew the
# screens.
echo "TIER3-INSTALL-OK packages: $(pacman -Q | grep -e kmscon -e libtsm -e vtium | tr '\n' ' ');" \
    "kernel: $(uname -r);" \
    "images: $images;" \
    "tree: $tree" > /dev/ttyS0
