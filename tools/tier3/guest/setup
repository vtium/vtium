#!/bin/sh
# Per-run guest setup, run as root at boot from the T3PKG disc mounted at $1:
# unpacks vtium's install tree (tree.tar) over the root, installs the
# variant's config, its test fonts and the scenario screens, and builds its
# font sets.
set -eu
disc=$1
tar -xpf "$disc"/tree.tar -C / --no-overwrite-dir --keep-directory-symlink
tree=$(sha256sum "$disc"/tree.tar | cut -d' ' -f1)
# A variant naming features runs vtium built with them in place of the
# tree's binary.
if [ -f "$disc"/vtium ]; then
    install -m755 "$disc"/vtium /usr/bin/vtium
fi
install -Dm644 "$disc"/kmscon.conf /etc/kmscon/kmscon.conf
# A variant drawing with the test fonts names them in its config.
if [ -d "$disc"/fonts ]; then
    install -Dm644 -t /usr/local/share/tier3-fonts "$disc"/fonts/*
fi
# A variant drawing a PSF font draws the set built from it (ADR-1200 D9):
# its frits are built into the store before the console starts, as a
# package hook builds them, and each set's line goes to the serial console.
if [ -d "$disc"/frits ]; then
    install -Dm644 -t /etc/vtium/fonts "$disc"/frits/*.vtfrit
    for frit in "$disc"/frits/*.vtfrit; do
        vtium-vitrify create "$(basename "$frit" .vtfrit)" > /dev/ttyS0
    done
fi
# A variant whose font is a frit generated at run time installs it with no
# set built (ADR-1301 D2). One that holds the helper replaces vtium-vitrify
# with a program that never answers, so the screens show what the console
# draws before any answer.
if [ -d "$disc"/deferred-frits ]; then
    install -Dm644 -t /etc/vtium/fonts "$disc"/deferred-frits/*.vtfrit
fi
if [ -f "$disc"/helper-held ]; then
    printf '#!/bin/sh\nexec /usr/bin/sleep 3600\n' > /usr/bin/vtium-vitrify
    chmod 755 /usr/bin/vtium-vitrify
fi
# The pointer variant's screens read the display's DRM atomic state as
# tester (screens/pointer.sh), so debugfs is opened to them.
if [ -f "$disc"/pointer ]; then
    mountpoint -q /sys/kernel/debug || mount -t debugfs debugfs /sys/kernel/debug
    chmod 0755 /sys/kernel/debug
fi
# A power variant's kernel settings, such as kernel.ctrl-alt-del for the
# hard reboot, set before the console starts.
if [ -f "$disc"/sysctl.conf ]; then
    sysctl -q -p "$disc"/sysctl.conf
fi
# The console's log also goes to the serial console, so the harness can read
# which video backend and text renderer drew the screens.
mkdir -p /etc/systemd/system/kmsconvt@.service.d
printf '[Service]\nStandardOutput=journal+console\nStandardError=journal+console\n' \
    > /etc/systemd/system/kmsconvt@.service.d/tier3.conf
systemctl daemon-reload
rm -rf /usr/local/share/tier3
cp -r "$disc"/screens /usr/local/share/tier3
install -m755 "$disc"/t3 /usr/local/bin/t3
# ttyS1 is the harness's event port: the scenario reports a login and each
# drawn screen there, and the driver waits for those lines.
stty -F /dev/ttyS1 clocal
chmod 0666 /dev/ttyS1
echo 'echo "T3-LOGIN $(tty)" > /dev/ttyS1' > /etc/profile.d/tier3.sh
# Any kmscon, libtsm or vtium package installed, which must be none, and the
# tree unpacked, so the log shows which build drew the screens.
echo "TIER3-INSTALL-OK packages: $(pacman -Q | grep -e kmscon -e libtsm -e vtium | tr '\n' ' ');" \
    "tree: $tree" > /dev/ttyS0
