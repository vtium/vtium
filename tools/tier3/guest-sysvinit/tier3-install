#!/bin/sh
# Boot hook baked into the guest without systemd, run from /etc/rc.local at
# the end of the runlevel. When the harness attaches the disc labelled T3PKG,
# runs the disc's own setup script, which installs vtium's tree; everything a
# run changes lives on the disc. blkid finds the disc with or without a udev
# daemon.
set -eu
dev=$(blkid -L T3PKG) || {
    echo TIER3-INSTALL-SKIP > /dev/ttyS0
    exit 0
}
mnt=/run/t3pkg
mkdir -p "$mnt"
mount -o ro "$dev" "$mnt"
sh "$mnt"/setup "$mnt"
umount "$mnt"
