#!/bin/sh
# The linker, pkg-config and test runner the Makefile's arm targets name for
# each ARM target, each a link to this script named TRIPLE-TOOL. It points
# the tool at the target's sysroot (tools/arm/sysroot):
#
#   TRIPLE-cc           clang for the target, linking through lld
#   TRIPLE-pkg-config   pkg-config reading the sysroot's .pc files
#   TRIPLE-run          the binary under qemu-user, its libraries from the sysroot
#
# The linker is the host's clang with rustc's own lld, so a cross build needs
# no cross toolchain.
#
# A binary under TRIPLE-run starts the target's binaries too, as vtium's
# tests start vtium, so the kernel must hand them to qemu through
# binfmt_misc. When the host registers no qemu for the target, TRIPLE-run
# registers one in a binfmt_misc of its own, in a user namespace (Linux 6.7
# or later), and runs the binary there as the invoking user. Nothing on the
# host changes. Where the namespace or its binfmt_misc is refused, it runs
# qemu directly and says so.
set -eu
here=$(cd "$(dirname "$0")" && pwd)
name=${0##*/}
case $name in
aarch64-unknown-linux-gnu-*)
    arch=arm64 triple=aarch64-linux-gnu clang=aarch64-linux-gnu qemu=qemu-aarch64
    # The ELF header of an aarch64 executable, as qemu's binfmt rules match it
    magic='\x7fELF\x02\x01\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x02\x00\xb7\x00'
    mask='\xff\xff\xff\xff\xff\xff\xff\x00\xff\xff\xff\xff\xff\xff\xff\xff\xfe\xff\xff\xff'
    ;;
x86_64-unknown-linux-gnu-*)
    # Not an ARM target: the host's own architecture, linked against the
    # bookworm sysroot so the binary needs at most glibc 2.36
    arch=amd64 triple=x86_64-linux-gnu clang=x86_64-linux-gnu qemu=
    ;;
armv7-unknown-linux-gnueabihf-*)
    arch=armhf triple=arm-linux-gnueabihf clang=armv7-linux-gnueabihf qemu=qemu-arm
    magic='\x7fELF\x01\x01\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x02\x00\x28\x00'
    mask='\xff\xff\xff\xff\xff\xff\xff\x00\xff\xff\xff\xff\xff\xff\xff\xff\xfe\xff\xff\xff'
    ;;
*) echo "wrap: no ARM target is named $name" >&2; exit 1 ;;
esac
# $1 as one word of a shell command, in single quotes
quoted() { printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"; }
sysroot=$("$here/sysroot" dir $arch)
[ -d "$sysroot" ] || { echo "wrap: no $arch sysroot at $sysroot; make arm-sysroot fetches it" >&2; exit 1; }
case $name in
*-cc)
    lld=$(rustc --print sysroot)/lib/rustlib/$(rustc -vV | sed -n 's/^host: //p')/bin/gcc-ld/ld.lld
    exec clang --target=$clang --sysroot="$sysroot" --ld-path="$lld" "$@"
    ;;
*-pkg-config)
    export PKG_CONFIG_SYSROOT_DIR="$sysroot"
    export PKG_CONFIG_LIBDIR="$sysroot/usr/lib/$triple/pkgconfig:$sysroot/usr/share/pkgconfig"
    exec pkg-config "$@"
    ;;
*-run)
    [ -n "$qemu" ] || exec "$@"
    export QEMU_LD_PREFIX="$sysroot"
    # qemu opens a path that also exists in the sysroot from the sysroot,
    # so a test that reads the kernel's UAPI headers from /usr/include
    # would read Debian 12's. qemu passes the tests' ioctls to the host's
    # kernel, so the tests read the host's headers, through a path that
    # does not exist in the sysroot.
    export VTIUM_KERNEL_HEADERS="${VTIUM_KERNEL_HEADERS:-/proc/self/root/usr/include}"
    # The tests qemu-user cannot judge skip when this is set and qemu's
    # symptom shows, and say so; this names them on the test binary's run.
    export VTIUM_QEMU_USER="$qemu"
    binfmt=/proc/sys/fs/binfmt_misc
    if [ -n "${VTIUM_ARM_IDS-}" ]; then
        # In the namespace, as its root: register qemu, then map back to the
        # invoking user.
        ids=$VTIUM_ARM_IDS
        unset VTIUM_ARM_IDS
        mount -t binfmt_misc binfmt_misc "$binfmt"
        # The entry names a script beside the sysroot that runs qemu with
        # the sysroot as its -L. A test that starts a target binary with an
        # empty environment, as vtium starts its helpers, passes on no
        # QEMU_LD_PREFIX, and qemu would not find the target's loader.
        run=$sysroot.$qemu
        script=$(printf '#!/bin/sh\nexec %s -L %s "$@"' "$(quoted "$(command -v $qemu)")" "$(quoted "$sysroot")")
        if [ ! -f "$run" ] || [ "$(cat "$run")" != "$script" ]; then
            part=$(mktemp "$run.XXXXXX")
            printf '%s\n' "$script" > "$part"
            chmod 755 "$part"
            mv "$part" "$run"
        fi
        printf '%s' ":$qemu:M::$magic:$mask:$run:" > "$binfmt/register"
        # vtium reads a file only when root or the account it runs as owns
        # each directory above it (ADR-1403 D3). The namespace maps no root,
        # so root's files and directories belong to the overflow uid, 65534,
        # there. The tests therefore run in a root of their own, a tmpfs
        # with the host's top-level entries bound into it, except for the
        # directories above the test binary that root owns. Those are made
        # anew on the tmpfs, so they belong to the invoking user, as the
        # tests need them to belong to root or to that user on any host.
        # top is the highest directory above the binary that the invoking
        # user owns, which is root, uid 0, in this namespace.
        top=$(dirname "$1")
        while [ "$top" != / ] && [ "$(stat -c %u "$(dirname "$top")")" = 0 ]; do
            top=$(dirname "$top")
        done
        set -- --wd="$PWD" "$@"
        if [ "$top" != / ]; then
            new=$sysroot.root
            mkdir -p "$new"
            mount -t tmpfs -o mode=755 tmpfs "$new"
            mkdir -p "$new$top"
            mount --rbind "$top" "$new$top"
            rest=${top#/}
            first=/${rest%%/*}
            for entry in /* /.[!.]*; do
                if [ -L "$entry" ]; then
                    ln -s "$(readlink "$entry")" "$new$entry"
                elif [ "$entry" = "$first" ] || [ ! -e "$entry" ]; then
                    continue
                elif [ -d "$entry" ]; then
                    # an automount point that refuses the bind stays empty
                    mkdir "$new$entry"
                    mount --rbind "$entry" "$new$entry" 2>/dev/null || :
                else
                    : > "$new$entry"
                    mount --bind "$entry" "$new$entry" 2>/dev/null || :
                fi
            done
            set -- --root="$new" "$@"
        fi
        exec unshare --user --map-user="${ids%:*}" --map-group="${ids#*:}" "$@"
    fi
    case ${1##*/} in
    vtium_platform-*) echo "wrap: under $qemu, display::card::tests::a_render_node_through_the_real_ioctls skips if its DRM ioctl answers ENOTTY" >&2 ;;
    check_config-*) echo "wrap: under $qemu, it_opens_nothing_but_the_configuration skips if strace traces qemu" >&2 ;;
    vtium-*) echo "wrap: under $qemu, helper::tests::a_failed_start_names_proc_self_fd skips if a program no one may execute starts, and check::tests' assertions about root's own helper skip if root does not own /bin/sh" >&2 ;;
    vtium_config-*) echo "wrap: under $qemu, serve::tests::the_helpers_socket_filter_refuses_every_new_socket skips if seccomp answers ENOSYS, and serve::tests::the_helpers_socket_filter_refuses_io_uring skips if python3 is the host's" >&2 ;;
    esac
    if [ ! -e "$binfmt/$qemu" ]; then
        # The probe mounts a binfmt_misc too: before Linux 6.7 a user
        # namespace has none of its own.
        if unshare --user --map-root-user --mount mount -t binfmt_misc binfmt_misc "$binfmt" 2>/dev/null; then
            VTIUM_ARM_IDS=$(id -u):$(id -g) exec unshare --user --map-root-user --mount "$0" "$@"
        fi
        echo "wrap: no binfmt_misc entry for $qemu, and no binfmt_misc in a user namespace: the target binaries this one starts will not run" >&2
    fi
    exec $qemu "$@"
    ;;
*) echo "wrap: no tool is named $name" >&2; exit 1 ;;
esac
