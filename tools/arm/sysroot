#!/bin/sh
# The Debian sysroots vtium's ARM builds link against and qemu-user runs the
# tests in. pin.tsv names the archive snapshot, the key its index is signed
# by, and each package by version and SHA-256; a sysroot is those packages
# extracted, with no package manager and no root.
#
#   sysroot fetch ARCH...   extract ARCH's pinned packages into its sysroot
#   sysroot dir ARCH        print ARCH's sysroot
#   sysroot pin             resolve pin.tsv's packages again from its snapshot
#
# ARCH is a Debian architecture, arm64 or armhf. The sysroots live in
# VTIUM_ARM_SYSROOTS (default $XDG_CACHE_HOME/vtium/arm), shared by every
# checkout: ARCH-ID, where ID is a digest of ARCH's pin rows and of this
# script, so checkouts with different pins each have their own, and a change
# to either extracts a new one. The packages are cached in debs/ and checked
# against their pins on every extraction.
set -eu
here=$(cd "$(dirname "$0")" && pwd)
pins=$here/pin.tsv
root=${VTIUM_ARM_SYSROOTS:-${XDG_CACHE_HOME:-$HOME/.cache}/vtium/arm}

die() { echo "sysroot: $*" >&2; exit 1; }
field() { awk -F'\t' -v k="$1" '$1 == k { print $2; exit }' "$pins"; }
debs() { awk -F'\t' -v a="$1" '$1 == "deb" && $2 == a' "$pins"; }
dir() {
    id=$({ debs "$1"; cat "$here/sysroot"; } | sha256sum | cut -c1-16)
    echo "$root/$1-$id"
}

# Copies the package at pool path $2 into $3 and checks the copy against
# SHA-256 $1; a cached package that fails is fetched again, and a download
# enters the cache only once it matches.
deb() {
    cached=$root/debs/${2##*/}
    if [ -f "$cached" ]; then
        cp "$cached" "$3"
        echo "$1  $3" | sha256sum -c --quiet - 2>/dev/null && return
        rm -f "$cached"
    fi
    part=$(mktemp "$root/debs/.${2##*/}.XXXXXX")
    curl -fsSL --retry 3 -o "$part" "$(field snapshot)/$2" || { rm -f "$part"; die "${2##*/}: download failed"; }
    echo "$1  $part" | sha256sum -c --quiet - || { rm -f "$part"; die "${2##*/}: SHA-256 differs from pin.tsv"; }
    mv "$part" "$cached"
    cp "$cached" "$3"
    echo "$1  $3" | sha256sum -c --quiet - || die "${2##*/}: SHA-256 of the copy differs from pin.tsv"
}

# Keeps the tree at $1 inside itself: rewrites each absolute symlink as a
# relative one, and refuses a link that resolves outside the tree.
contain() {
    find "$1" -type l | while IFS= read -r link; do
        target=$(readlink "$link")
        case $target in
        /*)
            ln -sfn "$(realpath -m -s --relative-to="$(dirname "$link")" "$1$target")" "$link"
            ;;
        esac
        case $(realpath -m "$link") in
        "$1" | "$1"/*) ;;
        *) die "${link#"$1"/} -> $target leaves the sysroot" ;;
        esac
    done
}

fetch() {
    arch=$1
    rows=$(debs "$arch")
    [ -n "$rows" ] || die "pin.tsv pins no packages for $arch"
    dir=$(dir "$arch")
    [ ! -d "$dir" ] || return 0
    mkdir -p "$root/debs"
    tmp=$(realpath "$(mktemp -d "$root/.$arch.XXXXXX")")
    trap 'rm -rf "$tmp"' EXIT
    # The sysroot is /usr-merged, so the dynamic loader finds every library
    # in /usr/lib/TRIPLE. qemu-user resolves open() in the sysroot but not
    # statx(), so a loader search of /lib/TRIPLE that misses marks the
    # directory absent, and a library only there is then never found.
    mkdir -p "$tmp/usr/lib" "$tmp/usr/bin" "$tmp/usr/sbin" "$tmp/etc"
    ln -s usr/lib "$tmp/lib"
    ln -s usr/bin "$tmp/bin"
    ln -s usr/sbin "$tmp/sbin"
    # An empty loader cache, so the loader searches the sysroot's
    # directories and never reads the host's cache, whose 32-bit entries
    # name the host's libraries.
    : > "$tmp/etc/ld.so.cache"
    work=$(mktemp -d "$root/.$arch-work.XXXXXX")
    trap 'rm -rf "$tmp" "$work"' EXIT
    echo "$rows" | while IFS="$(printf '\t')" read -r _ _ pkg _ sha path; do
        deb "$sha" "$path" "$work/pkg.deb"
        data=$(ar t "$work/pkg.deb" | grep '^data\.tar')
        (cd "$work" && ar x pkg.deb "$data")
        ! tar -tf "$work/$data" | grep -Eq '^/|(^|/)\.\.(/|$)' ||
            die "$pkg: a member's path leaves the sysroot"
        # A directory link an earlier package left is followed, and
        # contain has kept every such link inside the sysroot. GNU tar
        # makes an archive's own absolute or .. links last.
        tar -C "$tmp" --keep-directory-symlink -xf "$work/$data"
        rm -f "$work/pkg.deb" "$work/$data"
        contain "$tmp"
    done
    rm -rf "$work"
    # A second fetch that finished first leaves its sysroot, which is the
    # same one.
    mv -T "$tmp" "$dir" 2>/dev/null || [ -d "$dir" ] || die "cannot move the $arch sysroot to $dir"
    trap - EXIT
    rm -rf "$tmp"
    echo "sysroot: $arch in $dir"
}

# Resolves every pinned package again from the snapshot's index: InRelease
# verified against the pinned key, the arch's Packages.xz against InRelease,
# and the version, path and SHA-256 read from Packages. The key is fetched
# into a keyring beside the sysroots, never the user's.
pin() {
    snapshot=$(field snapshot)
    key=$(field key)
    suite=$(field suite)
    work=$(mktemp -d)
    trap 'rm -rf "$work"' EXIT
    export GNUPGHOME="$root/gnupg"
    [ -d "$GNUPGHOME" ] || { mkdir -p "$root" && mkdir -m 700 "$GNUPGHOME"; }
    gpg --batch --list-keys "$key" >/dev/null 2>&1 ||
        gpg --batch --keyserver hkps://keyserver.ubuntu.com --recv-keys "$key"
    curl -fsSL --retry 3 -o "$work/InRelease" "$snapshot/dists/$suite/InRelease"
    # gpg fails on InRelease's other signatures, whose keys the keyring
    # lacks; the status line for the pinned key is the verdict.
    gpg --batch --status-file "$work/status" --output "$work/Release" \
        --decrypt "$work/InRelease" 2>/dev/null || true
    grep -q "^\[GNUPG:\] VALIDSIG .* $key\$" "$work/status" ||
        die "InRelease is not signed by $key"
    # An older signed InRelease, replayed, names another codename or an
    # earlier date than the snapshot's; a later one cannot be in it.
    grep -qx "Codename: $suite" "$work/Release" || die "InRelease is not $suite's"
    released=$(date -d "$(sed -n 's/^Date: //p' "$work/Release")" +%s)
    taken=$(date -d "$(echo "${snapshot##*/}" | sed 's/^\(....\)\(..\)\(..\)T\(..\)\(..\)\(..\)Z$/\1-\2-\3T\4:\5:\6Z/')" +%s)
    [ "$released" -le "$taken" ] || die "InRelease is dated after the snapshot"
    {
        grep -v '^deb	' "$pins"
        for arch in $(awk -F'\t' '$1 == "deb" { print $2 }' "$pins" | uniq); do
            index=main/binary-$arch/Packages.xz
            sha=$(awk -v f="$index" '/^SHA256:/ { s = 1; next } /^[^ ]/ { s = 0 } s && $3 == f { print $1 }' "$work/Release")
            [ -n "$sha" ] || die "Release lists no $index"
            curl -fsSL --retry 3 -o "$work/Packages.xz" "$snapshot/dists/$suite/$index"
            echo "$sha  $work/Packages.xz" | sha256sum -c --quiet - || die "$index: SHA-256 differs from Release"
            xz -dc "$work/Packages.xz" > "$work/Packages"
            for pkg in $(debs "$arch" | cut -f3); do
                awk -v p="$pkg" -v a="$arch" '
                    /^Package: / { hit = ($2 == p) }
                    hit && /^Version: / { v = $2 }
                    hit && /^Filename: / { f = $2 }
                    hit && /^SHA256: / { s = $2 }
                    /^$/ && hit { print "deb\t" a "\t" p "\t" v "\t" s "\t" f; found = 1; exit }
                    END { if (!found) exit 1 }' "$work/Packages" ||
                    die "$suite $arch has no $pkg"
            done
        done
    } > "$work/pin.tsv"
    mv "$work/pin.tsv" "$pins"
    echo "sysroot: pin.tsv resolved from $snapshot"
}

case ${1-} in
fetch)
    shift
    [ $# -gt 0 ] || die "fetch needs an ARCH"
    for arch; do fetch "$arch"; done
    ;;
dir) dir "${2:?sysroot dir needs an ARCH}" ;;
pin) pin ;;
*) die "usage: sysroot fetch ARCH... | dir ARCH | pin" ;;
esac
