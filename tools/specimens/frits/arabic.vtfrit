# arabic: a font set for Arabic, Persian and Urdu (vtium/vtium#204). Noto
# Sans Mono draws Latin text and sets the character cell, and Noto Sans
# Arabic draws the Arabic script at Noto Sans Mono's size. vtium ships this
# font set, never the fonts. The font helper leaves out a font that the
# machine lacks, and then the built-in font draws those characters.
#
# Arabic writes marks above and below the letters: hamza, the vowel marks
# (harakat) and shadda, sometimes two in a stack. Noto Sans Arabic's
# highest marks and its deepest letters and marks reach past the text's
# height. Line spacing of 30 adds three twentieths of the text's height
# above each row and as much below it, so the marks of one row stay clear
# of the letters and marks of the rows above and below.
#
# Licences, as each source's documentation gives them:
# - Noto Sans Mono: SIL OFL 1.1.
# - Noto Sans Arabic: SIL OFL 1.1.

name=arabic
license=OFL-1.1

# Latin text, setting the cell at each size. It holds no Arabic.
source=font:Noto Sans Mono
# Arch's noto-fonts installs it.

# The Arabic script, its marks and its presentation forms, which Noto Sans
# Mono lacks. Its marks may use the rows that line spacing adds. Arabic is
# room by default; the line says so for the reader.
source=font:Noto Sans Arabic
fit=room
# Arch's noto-fonts installs it.

line-spacing=30
