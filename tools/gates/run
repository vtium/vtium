#!/usr/bin/env python3
"""
run - run every gate of AGENTS.md's gate line, several at once, each to the end

Usage:

    make gates
    make gates JOBS=4
    GATE_LINE="$(...)" tools/gates/run --jobs N --dir DIR [--build-root ROOT|auto]

`make gates` runs this script. The Makefile's GATE_LINE lists the gates, one
command per line in the gate line's order, and reaches the script through the
environment. `make test-tools` checks that GATE_LINE is the gate line AGENTS.md
lists.

The script runs up to N gates at once (--jobs, 1 or more). With N at 1 it runs
them one after another, in the gate line's order, as the gate line itself does.
Each gate runs to the end, whatever the others do: a failed gate stops nothing.
Each gate runs through `sh -c`, from the directory the script starts in, with
its standard input at /dev/null.

Each gate writes its output to a log of its own, DIR/logs/NN-NAME.log, where NN
is the gate's place in the gate line and NAME is the gate's command in lower
case with each run of other characters than a-z and 0-9 made one hyphen, such
as 03-make-test-all-features.log. The script replaces each log at
each run. With N at 1, the output also goes to the terminal as the gate runs.
With N above 1 it goes to the log alone, so the output of gates that run at the
same time never interleaves, and the terminal gets a line as each gate starts
and as it ends.

Each gate runs with CARGO_TARGET_DIR set to ROOT/NAME, a cargo target directory
of its own. ROOT is DIR unless --build-root names another directory. Two gates
that shared one would wait on each other's lock on it, and two that build with
different features, such as `make test-all-features` and `make test-default`,
would each rebuild what the other built. Each directory stays between runs, so
a second run builds only what changed. The Makefile's targets read
CARGO_TARGET_DIR wherever they name a cargo target directory.

With --build-root auto, the target directories go on the ramdisk when /tmp is a
tmpfs, because builds there never wait on the disk. ROOT is then
/tmp/vtium-gates/CHECKOUT, or $VTIUM_GATES_DIR/CHECKOUT when that variable is
set, where CHECKOUT is the checkout's path with each run of other characters
than letters, digits, dots, underscores and hyphens made one hyphen. The name
carries the whole path, so two worktrees never share a target directory. The
script uses /tmp only while it has room: 48 GiB free for a new ROOT, or 16 GiB
for a ROOT that an earlier run left. Otherwise ROOT is DIR, on the disk.
VTIUM_GATES_DIR skips the check, since whoever sets it chose the place. A
target directory grows with every run, so a ROOT on /tmp that has grown past
80 GiB is removed before the run, which then builds from the start. The script
also removes each ROOT under the same parent whose checkout no longer exists,
which it reads from the file ROOT/checkout. It writes the ROOT it chose to
DIR/build-root, where `make gates` reads it for the minspec size build.

With N above 1, the gates start in the order of the time each took in the last
run, the longest first, so that the longest gates never wait for a free slot at the
end. The script records those times in DIR/durations.tsv. A gate with no
recorded time starts first, in the gate line's order.

When every gate has ended, the script prints a table with one line per gate in
the gate line's order: the gate's exit code, two spaces and the gate. Then it
prints "gates: all passed" and exits 0, or names the log of each gate that
failed, prints "gates: FAILED" and exits 1. It exits 2 before it runs anything
when the gate list is empty or --jobs is not a whole number of 1 or more.
"""

import argparse
import os
import re
import shutil
import subprocess
import sys
import threading
import time
from concurrent.futures import ThreadPoolExecutor
from pathlib import Path


def name_of(gate):
    """The gate's command as a file name: lower case, each run of other
    characters than a-z and 0-9 made one hyphen."""
    return re.sub(r"[^a-z0-9]+", "-", gate.lower()).strip("-")


def gates_of(text):
    """The gates of GATE_LINE, one a line, with their names. Two gates with
    one name would share a target directory and a log, so that is refused."""
    gates = [line.strip() for line in text.splitlines() if line.strip()]
    names = [name_of(g) for g in gates]
    for n in set(names):
        if names.count(n) > 1:
            raise ValueError(f"two gates have the name {n!r}")
    return list(zip(gates, names))


GIB = 1 << 30
# The space /tmp needs free for a new ROOT and for one an earlier run left,
# and the size past which a ROOT on /tmp is removed before the run.
TMPFS_NEW = 48 * GIB
TMPFS_KEPT = 16 * GIB
TMPFS_CAP = 80 * GIB


def checkout_name(path):
    """The checkout's path as one directory name."""
    return re.sub(r"[^A-Za-z0-9._-]+", "-", str(path)).strip("-")


def is_tmpfs(mount):
    """Whether `mount` is the mount point of a tmpfs."""
    try:
        with open("/proc/self/mounts") as f:
            return any(line.split()[1:3] == [mount, "tmpfs"] for line in f)
    except OSError:
        return False


def size_of(path):
    """The bytes the files under `path` take, without following links."""
    total = 0
    for top, dirs, files in os.walk(path):
        for f in files:
            try:
                total += os.lstat(os.path.join(top, f)).st_blocks * 512
            except OSError:
                pass
    return total


def prune(parent, keep):
    """Removes each ROOT under `parent`, other than `keep`, whose recorded
    checkout no longer exists."""
    try:
        roots = list(parent.iterdir())
    except OSError:
        return
    for root in roots:
        if root == keep:
            continue
        try:
            checkout = (root / "checkout").read_text().strip()
        except OSError:
            continue
        if checkout and not Path(checkout).is_dir():
            print(f"gates: removing {root}, whose checkout {checkout} is gone", flush=True)
            shutil.rmtree(root, ignore_errors=True)


def auto_root(dir, checkout):
    """The ROOT --build-root auto chooses, as the docstring describes."""
    chosen = os.environ.get("VTIUM_GATES_DIR")
    parent = Path(chosen) if chosen else Path("/tmp/vtium-gates")
    root = parent / checkout_name(checkout)
    if not chosen:
        if not is_tmpfs("/tmp"):
            return dir
        if root.exists() and size_of(root) > TMPFS_CAP:
            print(f"gates: {root} has grown past {TMPFS_CAP // GIB} GiB, so the gates build from the start",
                  flush=True)
            shutil.rmtree(root, ignore_errors=True)
        free = shutil.disk_usage("/tmp").free
        if free < (TMPFS_KEPT if root.exists() else TMPFS_NEW):
            print(f"gates: /tmp has {free // GIB} GiB free, so the gates build in {dir}", flush=True)
            return dir
    root.mkdir(parents=True, exist_ok=True)
    (root / "checkout").write_text(f"{checkout}\n")
    prune(parent, root)
    return root


def read_durations(path):
    """{gate: seconds} from the last run's durations.tsv, or {}."""
    out = {}
    try:
        for line in path.read_text().splitlines():
            secs, _, gate = line.partition("\t")
            out[gate] = float(secs)
    except (OSError, ValueError):
        return {}
    return out


class Run:
    """One run of the gates: where their logs and target directories go, and
    the lock that keeps the lines the script prints whole."""

    def __init__(self, gates, jobs, dir, build_root=None):
        self.gates = gates
        self.jobs = jobs
        self.dir = dir
        self.root = build_root or dir
        self.logs = dir / "logs"
        self.lock = threading.Lock()
        self.took = {}

    def say(self, line):
        with self.lock:
            print(line, flush=True)

    def log_of(self, i):
        return self.logs / f"{i + 1:02d}-{self.gates[i][1]}.log"

    def gate(self, i):
        """Runs gate i to its end and returns its exit code."""
        gate, name = self.gates[i]
        env = dict(os.environ, CARGO_TARGET_DIR=str(self.root / name))
        log = self.log_of(i)
        self.say(f"==> {gate}" + ("" if self.jobs == 1 else f" (log: {log})"))
        start = time.monotonic()
        with open(log, "wb") as out:
            if self.jobs == 1:
                code = self.tee(gate, env, out)
            else:
                code = subprocess.run(["sh", "-c", gate], stdin=subprocess.DEVNULL, stdout=out,
                                      stderr=subprocess.STDOUT, env=env).returncode
        # A shell killed by signal S reports -S; the table gives 128 + S, as
        # a shell's $? does.
        if code < 0:
            code = 128 - code
        # The time a gate took is printed for the person reading the run;
        # nothing the script decides depends on it.
        took = time.monotonic() - start
        self.took[gate] = took
        self.say(f"<== {code}  {gate} ({took:.0f} s)")
        return code

    def tee(self, gate, env, out):
        """Runs the gate with its output going both to the log and to this
        script's standard output, as it comes."""
        p = subprocess.Popen(["sh", "-c", gate], stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                             stderr=subprocess.STDOUT, env=env)
        while chunk := p.stdout.read1(65536):
            out.write(chunk)
            sys.stdout.buffer.write(chunk)
            sys.stdout.buffer.flush()
        return p.wait()

    def run(self):
        self.logs.mkdir(parents=True, exist_ok=True)
        self.root.mkdir(parents=True, exist_ok=True)
        if self.root != self.dir:
            print(f"gates: the gates build in {self.root}", flush=True)
        # With more than one job, the longest gates of the last run start
        # first; the order of the table does not change.
        durations = self.dir / "durations.tsv"
        last = read_durations(durations) if self.jobs > 1 else {}
        order = sorted(range(len(self.gates)),
                       key=lambda i: -last.get(self.gates[i][0], float("inf")))
        pool = ThreadPoolExecutor(max_workers=self.jobs)
        try:
            futures = {i: pool.submit(self.gate, i) for i in order}
            codes = [futures[i].result() for i in range(len(self.gates))]
        except KeyboardInterrupt:
            # Ctrl-C reached the running gates too, which share this
            # script's process group; the gates still waiting never start.
            pool.shutdown(wait=True, cancel_futures=True)
            print("gates: interrupted", file=sys.stderr)
            return 130
        pool.shutdown()
        durations.write_text("".join(f"{self.took[g]:.0f}\t{g}\n" for g, _ in self.gates))
        print()
        print("exit  gate")
        for (gate, _), code in zip(self.gates, codes):
            print(f"{code}  {gate}")
        failed = [i for i, code in enumerate(codes) if code != 0]
        if not failed:
            print("gates: all passed")
            return 0
        for i in failed:
            print(f"log of {self.gates[i][0]}: {self.log_of(i)}")
        sys.stdout.flush()
        print("gates: FAILED", file=sys.stderr)
        return 1


def main():
    ap = argparse.ArgumentParser(description="Run the gates of GATE_LINE, several at once, each to the end.")
    ap.add_argument("--jobs", default="8", help="the most gates that run at once (default 8)")
    ap.add_argument("--dir", required=True, type=Path,
                    help="where the logs go, and each gate's cargo target directory unless "
                         "--build-root names another place")
    ap.add_argument("--build-root", metavar="ROOT|auto",
                    help="where each gate's cargo target directory goes; auto picks the "
                         "ramdisk when /tmp is a tmpfs with room (default DIR)")
    args = ap.parse_args()
    if not re.fullmatch(r"[1-9][0-9]*", args.jobs):
        print(f"gates: JOBS={args.jobs}: a whole number of 1 or more", file=sys.stderr)
        return 2
    try:
        gates = gates_of(os.environ.get("GATE_LINE", ""))
    except ValueError as e:
        print(f"gates: {e}", file=sys.stderr)
        return 2
    if not gates:
        print("gates: the gate list is empty", file=sys.stderr)
        return 2
    dir = args.dir.resolve()
    if args.build_root == "auto":
        root = auto_root(dir, Path.cwd().resolve())
    else:
        root = Path(args.build_root).resolve() if args.build_root else dir
    dir.mkdir(parents=True, exist_ok=True)
    (dir / "build-root").write_text(f"{root}\n")
    return Run(gates, int(args.jobs), dir, root).run()


if __name__ == "__main__":
    sys.exit(main())
