#!/usr/bin/env python3
"""
features - lint and document each crate with fewer features than the gate line's --all-features

Usage:

    make features-check
    tools/gates/features [--list]

The gate line runs clippy and rustdoc with every feature on, so code that only
a build with fewer features compiles is never linted there: an import that only
a feature uses becomes an unused import without it, and a doc link to an item
that only a feature defines breaks. This script runs both checks with fewer
features. For each crate under crates/ whose Cargo.toml declares features, it
runs these three commands once with no feature and once with each feature
alone:

    cargo clippy -p CRATE FLAGS --lib --bins -- -D warnings
    cargo clippy -p CRATE FLAGS --all-targets -- -D warnings
    cargo doc --no-deps --lib -p CRATE FLAGS

clippy runs twice because a build of all targets includes the crate's
dev-dependencies, and cargo turns on the features they name for the library
too. vtium-font's tests depend on vtium-font with psf and gzip, for example, so
a clippy of all targets never lints vtium-font without them. The clippy of the
library and binaries alone builds without the dev-dependencies, so it lints the
library with exactly the features named.

rustdoc runs with RUSTDOCFLAGS from the environment, which `make
features-check` sets to `make api`'s flags, or with `-D warnings` when the
variable is unset. With no feature, FLAGS is empty, or --no-default-features
for a crate whose default features are not empty. With one feature, FLAGS adds
--features NAME. A crate whose default features are not empty also gets a run
with FLAGS empty, named "its default features", since that is the build cargo
makes when nobody names a feature.

The script reads the crates and their features from `cargo metadata`, so a new
crate or a new feature joins the check by itself. The runs go in lanes that
run at the same time: each crate's runs, up to four sets of features to a lane,
one after another in a lane. Each lane builds in a cargo directory of its
own, features/CRATE-N under the target directory that CARGO_TARGET_DIR names,
as cargo does; `make gates` gives each gate a directory of its own. That
directory is both the lane's target directory and its build directory, set
through CARGO_TARGET_DIR and CARGO_BUILD_BUILD_DIR. Two lanes that shared
either would wait on each other's lock. It runs every
combination to the end, prints one line for each with its result as it
finishes, and then prints the output of each failed run in the plan's order.
It exits 0 when every run passed and 1 when one failed, naming the crate, the
check and the features of each failed run. It exits 2 when it finds no crate
with features, since then it has checked nothing. --list prints the
combinations without running them.
"""

import argparse
import json
import os
import subprocess
import sys
import threading
import time
from concurrent.futures import ThreadPoolExecutor
from pathlib import Path

# The most sets of features of one crate that one lane runs.
LANE = 4


def plan(metadata):
    """The runs for the crates under crates/ that declare features, in the
    crates' order of name: a list of (crate, label, flags), each to be run
    with clippy and with rustdoc."""
    root = Path(metadata["workspace_root"]).resolve()
    runs = []
    packages = sorted(metadata["packages"], key=lambda p: p["name"])
    for p in packages:
        manifest = Path(p["manifest_path"]).resolve()
        if manifest.parent.parent != root / "crates":
            continue
        features = p["features"]
        named = sorted(f for f in features if f != "default")
        if not named:
            continue
        default = features.get("default", [])
        base = ["--no-default-features"] if default else []
        runs.append((p["name"], "no features", base))
        if default:
            runs.append((p["name"], "its default features", []))
        for f in named:
            runs.append((p["name"], f"--features {f}", base + ["--features", f]))
    return runs


def commands(crate, flags):
    """The three checks of one run, as (check, argv)."""
    lint = ["--", "-D", "warnings"]
    return [
        ("clippy (lib, bins)", ["cargo", "clippy", "-p", crate, *flags, "--lib", "--bins", *lint]),
        ("clippy (all targets)", ["cargo", "clippy", "-p", crate, *flags, "--all-targets", *lint]),
        ("rustdoc", ["cargo", "doc", "--no-deps", "--lib", "-p", crate, *flags]),
    ]


def lanes(runs):
    """The runs split into lanes: each crate's runs in order, up to LANE of
    them to a lane, as a list of (name, runs)."""
    out = []
    for crate in dict.fromkeys(c for c, _, _ in runs):
        mine = [r for r in runs if r[0] == crate]
        for n, i in enumerate(range(0, len(mine), LANE)):
            out.append((f"{crate}-{n}", mine[i:i + LANE]))
    return out


def main():
    ap = argparse.ArgumentParser(
        description="Lint and document each crate with no feature and with each feature alone.")
    ap.add_argument("--list", action="store_true",
                    help="print the combinations without running them")
    args = ap.parse_args()

    meta = subprocess.run(["cargo", "metadata", "--no-deps", "--format-version", "1"],
                          capture_output=True, text=True)
    if meta.returncode != 0:
        sys.stderr.write(meta.stderr)
        print("features: cargo metadata failed, so the check cannot list the crates.", file=sys.stderr)
        return 2
    runs = plan(json.loads(meta.stdout))
    if not runs:
        print("features: no crate under crates/ declares features, so there is nothing to check.",
              file=sys.stderr)
        return 2

    env = dict(os.environ)
    env.setdefault("RUSTDOCFLAGS", "-D warnings")
    checks = [(crate, label, check, argv)
              for crate, label, flags in runs
              for check, argv in commands(crate, flags)]
    if args.list:
        for crate, label, check, argv in checks:
            print(f"{check:22}{crate:16}{label}")
        return 0

    crates = len({c for c, _, _ in runs})
    split = lanes(runs)
    target = Path(json.loads(meta.stdout)["target_directory"]) / "features"
    print(f"features: {len(checks)} runs, clippy twice and rustdoc for {crates} crates, "
          f"in {len(split)} lanes")
    start = time.monotonic()
    lock = threading.Lock()
    results = {}

    def lane(name, mine):
        own = str(target / name)
        lane_env = dict(env, CARGO_TARGET_DIR=own, CARGO_BUILD_BUILD_DIR=own)
        for crate, label, flags in mine:
            for check, argv in commands(crate, flags):
                p = subprocess.run(argv, stdin=subprocess.DEVNULL, capture_output=True, text=True,
                                   env=lane_env)
                ok = p.returncode == 0
                with lock:
                    results[(crate, label, check)] = None if ok else p.stdout + p.stderr
                    print(f"{'ok  ' if ok else 'FAIL'}  {check:22}{crate:16}{label}", flush=True)

    with ThreadPoolExecutor(max_workers=len(split)) as pool:
        for f in [pool.submit(lane, name, mine) for name, mine in split]:
            f.result()
    failed = [(crate, label, check, argv, results[(crate, label, check)])
              for crate, label, check, argv in checks
              if results[(crate, label, check)] is not None]

    for crate, label, check, argv, output in failed:
        print()
        print(f"==> {check} of {crate} with {label} failed: {' '.join(argv)}")
        print(output.rstrip())
    print()
    took = time.monotonic() - start
    if failed:
        print(f"features: {len(failed)} of {len(checks)} runs failed ({took:.0f} s):")
        for crate, label, check, _, _ in failed:
            print(f"  {check} of {crate} with {label}")
        return 1
    print(f"features: all {len(checks)} runs passed ({took:.0f} s)")
    return 0


if __name__ == "__main__":
    sys.exit(main())
