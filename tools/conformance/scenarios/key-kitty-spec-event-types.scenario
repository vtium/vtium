# The kitty keyboard protocol's flag 2, report event types, on cases that
# the other event scenarios leave out. Under flag 1 alone, a repeat is
# sent as a press, and a release sends nothing. Under flags 3, Ctrl+F1
# and Shift+Insert carry their repeat and release event types after
# their modifiers, in the forms of the functional key table. Shift+A
# makes text, so it sends A on a press and on a repeat, and nothing on
# its release. Alt+Escape carries its repeat's event type.
# spec: kitty's Comprehensive keyboard handling in terminals: Report event types, Event types, Functional key definitions; ADR-1005 D7
# covers: input.kitty-keyboard
size 20 2
needs key-events
send "\e[>1u"
cmd key;sym=ff1b
cmd key;sym=ff1b;event=repeat
cmd key;sym=ff1b;event=release
send "\e[=3u"
cmd key;sym=ffbe;mods=4
cmd key;sym=ffbe;mods=4;event=repeat
cmd key;sym=ffbe;mods=4;event=release
cmd key;sym=ff63;mods=1
cmd key;sym=ff63;mods=1;event=release
cmd key;sym=41;ascii=41;unicode=41;mods=1
cmd key;sym=41;ascii=41;unicode=41;mods=1;event=repeat
cmd key;sym=41;ascii=41;unicode=41;mods=1;event=release
cmd key;sym=ff1b;mods=8
cmd key;sym=ff1b;mods=8;event=repeat
cmd key;sym=ff1b;mods=8;event=release
