# The kitty keyboard protocol's flag 2, report event types. Under flags 3 (1
# and 2), a key's press carries no event type, its repeat carries 2 and its
# release 3, after the modifiers and a colon; with no modifier held the
# modifiers field is 1. Once the flags are 0 again, a release sends nothing
# and the press of Escape is its legacy byte.
# spec: kitty's Comprehensive keyboard handling in terminals: Report event types, Event types; ADR-1005 D2 and D13 slice 2
# capability: key-kitty-events
size 20 2
needs key-events
send "\e[>3u\e[?u"
check
reply "\e[?3u"
cmd key;sym=ff1b
cmd key;sym=ff1b;event=repeat
cmd key;sym=ff1b;event=release
check
reply "\e[27u\e[27;1:2u\e[27;1:3u"
cmd key;sym=61;ascii=61;unicode=61;mods=4
cmd key;sym=61;ascii=61;unicode=61;mods=4;event=repeat
cmd key;sym=61;ascii=61;unicode=61;mods=4;event=release
check
reply "\e[97;5u\e[97;5:2u\e[97;5:3u"
send "\e[<u\e[?u"
cmd key;sym=ff1b;event=release
cmd key;sym=ff1b
check
reply "\e[?0u\e"
