# Normal tracking, mode 1000, reported in SGR encoding, mode 1006: CSI < b ; col ; row M for a press and m for a release.
# Each button is pressed and released over a cell, the wheel steps up and
# down, Shift, Alt and Ctrl are held over a press, and a move with no
# button held is not reported in this mode.
# spec: ctlseqs, Mouse Tracking
# covers: DEC-1006
size 20 5
send "\e[?1000h"
send "\e[?1006h"
send "\e[?1006$p"
mouse press left at 1,0
mouse release left at 1,0
mouse press middle at 2,1
mouse release middle at 2,1
mouse press right at 3,2
mouse release right at 3,2
wheel up at 4,3
wheel down at 4,3
mouse press left at 5,4 mods=shift
mouse release left at 5,4 mods=shift
mouse press left at 6,4 mods=alt
mouse release left at 6,4 mods=alt
mouse press left at 7,4 mods=ctrl
mouse release left at 7,4 mods=ctrl
wheel down at 8,4 mods=ctrl
mouse move at 9,4
send "\e[?1000l"
mouse press left at 1,0
