# OSC 8's links: each cell printed while a link is open keeps its URI,
# through a wrap and into the scrollback. An empty URI closes the link, and
# a URI with no scheme or with a space in it closes it too, so the text
# after it prints with no link. Pieces opened with the same id and URI are
# one link, which the pointer hovers whole, and while Ctrl is held the
# overlay row shows its URI: the bottom row, or the top row while the
# pointer is on the bottom one (ADR-1002; INTERFACE-vtium.md, Links).
# spec: ADR-1000 osc.8
# capability: osc-8-hyperlink
size 12 4
scrollback 20
send "\e]8;id=a;https://e.x/a\e\\one\e]8;;\e\\ two\r\n"
send "\e]8;;file://h/p\e\\abcdefghijklmn\e]8;;\e\\\r\n"
send "\e]8;;https://e.x/p\e\\p\e]8;;nocolon\e\\q\e]8;;https://e.x/r\e\\r\e]8;;https://e.x/a b\e\\s\e]8;;\e\\ \e]8;id=a;https://e.x/a\e\\tu\e]8;;\e\\"
link at 2,0
check
want row 0 |one two|
want row 1 |abcdefghijkl|
want row 2 |mn|
want row 3 |pqrs tu|
want test link 68747470733a2f2f652e782f61
link at 3,0
check
want test link none
link at 11,1
check
want test link 66696c653a2f2f682f70
link at 1,2
check
want test link 66696c653a2f2f682f70
link at 2,2
check
want test link none
link at 0,3
check
want test link 68747470733a2f2f652e782f70
link at 1,3
check
want test link none
link at 2,3
check
want test link 68747470733a2f2f652e782f72
link at 3,3
check
want test link none
hover at 1,0 ctrl
check
want test hover 0:0-2,3:5-6
want test overlay 3 68747470733a2f2f652e782f61
hover at 6,3 ctrl
check
want test hover 0:0-2,3:5-6
want test overlay 0 68747470733a2f2f652e782f61
hover at 6,3
check
want test overlay none
hover at 0,2
check
want test hover 1:0-11,2:0-1
hover none ctrl
check
want test hover none
want test overlay none
send "\r\n"
scroll up 1
link at 0,0
check
want row 0 |one two|
want test link 68747470733a2f2f652e782f61
