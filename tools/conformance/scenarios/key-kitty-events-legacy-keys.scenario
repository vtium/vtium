# The kitty keyboard protocol's flag 2 leaves Enter, Tab and BackSpace their
# legacy bytes and reports no release for them, so that a user can still type
# reset at a shell. A key that makes text sends its text on a press and on a
# repeat, and nothing on its release. BackSpace's legacy byte is 0x08, as the
# reference host chooses.
# spec: kitty's Comprehensive keyboard handling in terminals: Disambiguate escape codes, Report event types; ADR-1005 D6 and D13 slice 2
# capability: key-kitty-events-legacy-keys
size 20 2
needs key-events
send "\e[>3u\e[?u"
check
reply "\e[?3u"
cmd key;sym=ff0d
cmd key;sym=ff0d;event=release
cmd key;sym=ff09
cmd key;sym=ff09;event=release
cmd key;sym=ff08
cmd key;sym=ff08;event=release
check
reply "\r\t\b"
cmd key;sym=61;ascii=61;unicode=61
cmd key;sym=61;ascii=61;unicode=61;event=repeat
cmd key;sym=61;ascii=61;unicode=61;event=release
check
reply "aa"
