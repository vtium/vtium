# DECRQM answers each mode with DECRPM: 1 set, 2 reset, 3 always set,
# 4 always reset, and 0 for a mode vtium does not know. Each mode is
# asked at its default, after SM and after RM.
# spec: DEC STD 070, DECRQM and DECRPM; ctlseqs, DECRQM
# covers: query.decrqm
size 20 2
send "\e[2$p"
send "\e[4$p"
send "\e[12$p"
send "\e[20$p"
send "\e[99$p"
send "\e[?1$p"
send "\e[?3$p"
send "\e[?4$p"
send "\e[?5$p"
send "\e[?6$p"
send "\e[?7$p"
send "\e[?8$p"
send "\e[?9$p"
send "\e[?12$p"
send "\e[?25$p"
send "\e[?40$p"
send "\e[?45$p"
send "\e[?47$p"
send "\e[?66$p"
send "\e[?67$p"
send "\e[?69$p"
send "\e[?95$p"
send "\e[?1000$p"
send "\e[?1001$p"
send "\e[?1002$p"
send "\e[?1003$p"
send "\e[?1004$p"
send "\e[?1005$p"
send "\e[?1006$p"
send "\e[?1007$p"
send "\e[?1015$p"
send "\e[?1016$p"
send "\e[?1034$p"
send "\e[?1035$p"
send "\e[?1036$p"
send "\e[?1042$p"
send "\e[?1047$p"
send "\e[?1048$p"
send "\e[?1049$p"
send "\e[?2004$p"
send "\e[?2026$p"
send "\e[?2027$p"
send "\e[?7727$p"
send "\e[?9999$p"
send "\e[4h\e[20h"
send "\e[4$p\e[20$p"
send "\e[4l\e[20l"
send "\e[4$p\e[20$p"
send "\e[?7l\e[?25l\e[?2004h\e[?1000h"
send "\e[?7$p\e[?25$p\e[?2004$p\e[?1000$p"
