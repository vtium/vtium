# XTGETTCAP from the table generated from kmscon.ti: TN is kmscon, and Smulx
# comes back byte for byte as the entry has it, \E decoded and its % sequence
# kept, in one reply, each name in uppercase hex
# spec: ADR-1000 query.xtgettcap
# capability: xtgettcap
size 80 24
fixture kmscon.termcap
cmd termcap;file=kmscon.termcap
send "\eP+q544e;536d756c78\e\\"
check
reply "\eP1+r544E=6B6D73636F6E;536D756C78=1B5B343A25703125646D\e\\"
