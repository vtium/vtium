# Sealed expectation for kitty-upload-sixel-between.case, written from upload-rules.md before any implementation.
# Replies are exact. A '# expected in the dump' line says in words what the frame view must show.
> size 20 10
> send "\e_Ga=t,f=24,s=2,v=1,i=1,m=1;/wAA\e\\"
> send "\eP0;0;0q\"1;1;1;1#0;2;100;0;0#0~\e\\"
> send "\e_Gm=0;AP8A\e\\"
< reply "\e_Gi=1;OK\e\\"
> dump frame
# expected in the dump: the sixel's placement and image 1's
> send "\e_Ga=p,i=1,C=1\e\\"
< reply "\e_Gi=1;OK\e\\"
