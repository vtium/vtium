# Sealed expectation for kitty-upload-control-between.case, written from upload-rules.md before any implementation.
# Replies are exact. A '# expected in the dump' line says in words what the frame view must show.
> size 20 10
> send "\e_Ga=t,f=24,s=1,v=1,i=2;AAD/\e\\"
< reply "\e_Gi=2;OK\e\\"
> send "\e_Ga=f,i=2,f=24,s=1,v=1;////\e\\"
< reply "\e_Gi=2,r=2;OK\e\\"
> send "\e_Ga=t,f=24,s=2,v=1,i=1,m=1;/wAA\e\\"
> send "\e_Ga=a,i=2,c=2\e\\"
> send "\e_Ga=a,i=42,c=2\e\\"
< reply "\e_Gi=42;ENOENT:Animation command refers to non-existent image with id: 42 and number: 0\e\\"
> send "\e_Gm=0;AP8A\e\\"
< reply "\e_Gi=1;OK\e\\"
