# Sealed expectation for kitty-upload-cap-passed.case, written from upload-rules.md before any implementation.
# Replies are exact. A '# expected in the dump' line says in words what the frame view must show.
> size 20 10
> send "\e_Ga=t,f=24,s=1,v=1,i=1,m=1;/wAA\e\\"
> send "\e_Ga=f,i=2,f=24,s=1,v=1,m=1;\e\\"
< reply "\e_Gi=1;EINVAL:invalid argument\e\\"
> send "\e_Gm=0;AP8A\e\\"
> send "\e_Ga=p,i=1,C=1\e\\"
< reply "\e_Gi=1;ENOENT:Put command refers to non-existent image with id: 1 and number: 0\e\\"
