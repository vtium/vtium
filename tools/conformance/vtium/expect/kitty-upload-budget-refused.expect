# Sealed expectation for kitty-upload-budget-refused.case, written from upload-rules.md before any implementation.
# Replies are exact. A '# expected in the dump' line says in words what the frame view must show.
> size 20 10
> send "\e_Ga=t,f=24,s=1,v=1,i=1;AAD/\e\\"
< reply "\e_Gi=1;OK\e\\"
> send "\e_Ga=t,f=24,s=8012,v=9985,i=1,m=1;/wAA\e\\"
< reply "\e_Gi=1;ENOSPC:image storage is full\e\\"
> send "\e_Gm=0;AP8A\e\\"
> send "\e_Ga=p,i=1,C=1\e\\"
< reply "\e_Gi=1;OK\e\\"
