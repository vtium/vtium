# Sealed expectation for kitty-upload-query-between.case, written from upload-rules.md before any implementation.
# Replies are exact. A '# expected in the dump' line says in words what the frame view must show.
> size 20 10
> send "\e_Ga=t,f=24,s=2,v=1,i=1,m=1;/wAA\e\\"
> send "\e_Ga=q,i=5,f=24,s=1,v=1;AAAA\e\\"
< reply "\e_Gi=5;OK\e\\"
> send "\e_Ga=q,i=6,f=24,s=2,v=1;AAAA\e\\"
< reply "\e_Gi=6;ENODATA:Insufficient image data: 3 < 6\e\\"
> send "\e_Gm=0;AP8A\e\\"
< reply "\e_Gi=1;OK\e\\"
> send "\e_Ga=p,i=1,C=1\e\\"
< reply "\e_Gi=1;OK\e\\"
