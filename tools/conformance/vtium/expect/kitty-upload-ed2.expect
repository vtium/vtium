# Sealed expectation for kitty-upload-ed2.case, written from upload-rules.md before any implementation.
# Replies are exact. A '# expected in the dump' line says in words what the frame view must show.
> size 20 10
> send "\e[1;1H\e_Ga=T,f=24,s=2,v=1,i=1,c=4,r=2,C=1,m=1;/wAA\e\\"
> send "\e[2J"
> send "\e_Gm=0;AP8A\e\\"
< reply "\e_Gi=1;OK\e\\"
> dump frame
# expected in the dump: one placement of image 1 at column 0, row 0
> send "\e_Ga=p,i=1,C=1\e\\"
< reply "\e_Gi=1;OK\e\\"
