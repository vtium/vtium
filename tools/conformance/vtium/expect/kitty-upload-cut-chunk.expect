# Sealed expectation for kitty-upload-cut-chunk.case, written from the maintainer's answer of 2026-11-13 (ADR-1100 D16, "What ends an upload early") before any implementation.
# Replies are exact.
> size 20 10
> send "\e_Ga=t,f=24,s=2,v=1,i=1,m=1;/wAA\e\\"
> send "\e_Gm=1;AP8\x18"
< reply "\e_Gi=1;EINVAL:invalid argument\e\\"
> send "\e_Gm=0;AP8A\e\\"
> send "\e_Ga=p,i=1,C=1\e\\"
< reply "\e_Gi=1;ENOENT:Put command refers to non-existent image with id: 1 and number: 0\e\\"
> send "\e_Ga=t,f=24,s=2,v=1,i=2,q=2,m=1;/wAA\e\\"
> send "\e_Gm=1;AP8\x1a"
> send "\e_Ga=p,i=2,C=1\e\\"
< reply "\e_Gi=2;ENOENT:Put command refers to non-existent image with id: 2 and number: 0\e\\"
> send "\e_Ga=t,f=24,s=1,v=1,i=3;AAD/\e\\"
< reply "\e_Gi=3;OK\e\\"
> send "\e_Ga=t,f=24,s=2,v=1,i=3,m=1;/wAA\e\\"
> send "\e_Gm=1;AP8\x18"
< reply "\e_Gi=3;EINVAL:invalid argument\e\\"
> send "\e_Ga=p,i=3,C=1\e\\"
< reply "\e_Gi=3;OK\e\\"
