# Sealed expectation for kitty-upload-alt-two.case, written from upload-rules.md before any implementation.
# Replies are exact. A '# expected in the dump' line says in words what the frame view must show.
> size 20 10
> send "\e_Ga=t,f=24,s=2,v=1,i=1,m=1;/wAA\e\\"
> send "\e[?1049h"
> send "\e_Ga=t,f=24,s=1,v=1,i=2,m=1;AAD/\e\\"
> send "\e_Gm=0;\e\\"
< reply "\e_Gi=2;OK\e\\"
> send "\e_Ga=p,i=2,C=1\e\\"
< reply "\e_Gi=2;OK\e\\"
> send "\e[?1049l"
> send "\e_Gm=0;AP8A\e\\"
< reply "\e_Gi=1;OK\e\\"
> send "\e_Ga=p,i=1,C=1\e\\"
< reply "\e_Gi=1;OK\e\\"
> send "\e_Ga=p,i=2,C=1\e\\"
< reply "\e_Gi=2;ENOENT:Put command refers to non-existent image with id: 2 and number: 0\e\\"
