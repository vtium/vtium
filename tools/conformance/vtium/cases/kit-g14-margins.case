# A scroll inside top and bottom margins moves a kitty placement that lies
# wholly inside the region, and clips it at the region's edge. A placement
# that crosses the region's edge keeps its place. CSI S and CSI T both
# scroll the region.
# spec: kitty graphics protocol, "Interaction with other terminal actions"
# covers: image.kitty
size 12 4
cmd cell;w=8;h=16

# The region is rows 2 and 3.
send "\e[2;3r"

# Picture 1 fills one cell at row 2, inside the region.
send "\e[2;1H"
# 8×16, every pixel opaque red (ff0000ff)
send "\e_Ga=T,f=32,s=8,v=16,i=1,C=1;\e\\"

# Picture 2 is two rows tall from row 3, so it crosses the region's bottom.
send "\e[3;5H"
# 8×32, every pixel opaque green (00ff00ff)
send "\e_Ga=T,f=32,s=8,v=32,i=2,C=1;\e\\"
dump

# CSI S scrolls the region up one line.
send "\e[S"
dump

# CSI 2 T scrolls the region down two lines, and the margins are reset.
send "\e[2T"
send "\e[r"
