# The control for kitty-upload-budget-refused: with no old image, the same upload fits and opens.
# References: ADR-1100 D16.
# spec: ADR-1100 D16, "The reservation, and the old image under the same id"
# covers: image.kitty
# budget: the reference host's 320,000,000 bytes; the upload reserves 319,999,792.
size 20 10
send "\e_Ga=t,f=24,s=8012,v=9985,i=1,m=1;/wAA\e\\"
send "\e_Gm=0;AP8A\e\\"
