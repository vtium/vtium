# A sixel between kitty chunks leaves the kitty upload open.
# References: ADR-1100 D16.
# spec: ADR-1100 D16, "What leaves an upload open"
# covers: image.kitty image.sixel
size 20 10
send "\e_Ga=t,f=24,s=2,v=1,i=1,m=1;/wAA\e\\"
send "\eP0;0;0q\"1;1;1;1#0;2;100;0;0#0~\e\\"
send "\e_Gm=0;AP8A\e\\"
dump frame
send "\e_Ga=p,i=1,C=1\e\\"
