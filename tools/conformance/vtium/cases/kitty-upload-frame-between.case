# A frame sent during an image's upload is the upload's next chunk.
# Rule P3 (decided 2026-11-13) of upload-rules.md.
# spec: the kitty graphics protocol (sw.kovidgoyal.net/kitty/graphics-protocol, read 2026-11-13)
# covers: image.kitty image.kitty-animation
size 20 10
send "\e_Ga=t,f=24,s=1,v=1,i=2;AAD/\e\\"
send "\e_Ga=t,f=24,s=2,v=1,i=1,m=1;/wAA\e\\"
send "\e_Ga=f,i=2,f=24,s=1,v=1;////\e\\"
send "\e_Gm=0;AP8A\e\\"
send "\e_Ga=p,i=1,C=1\e\\"
