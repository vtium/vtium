# The cursor after a kitty picture taller than the screen, and after one
# exactly as wide as the screen. CSI 6 n reports the cursor each time.
# spec: kitty graphics protocol, "Controlling displayed image layout"
# covers: image.kitty
size 12 4
cmd cell;w=8;h=16
cmd sb-max;n=10

# Text on the top row, then the cursor goes to row 2, column 2.
send "top"
send "\e[2;2H"

# Picture 1 is one cell wide and six rows tall, and the cursor moves after it.
# 8×96, every pixel opaque red (ff0000ff)
send "\e_Ga=T,f=32,s=8,v=96,i=1;\e\\"
send "\e[6n"
dump

# Picture 2 is twelve cells wide, the screen's width, placed at the top left.
send "\e[1;1H"
# 96×16, every pixel opaque red (ff0000ff)
send "\e_Ga=T,f=32,s=96,v=16,i=2;\e\\"
send "\e[6n"
