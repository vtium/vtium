# ED 2 between chunks leaves the upload open.
# Rule P7 (decided 2026-11-13) of upload-rules.md.
# spec: the kitty graphics protocol (sw.kovidgoyal.net/kitty/graphics-protocol, read 2026-11-13)
# covers: image.kitty
size 20 10
send "\e[1;1H\e_Ga=T,f=24,s=2,v=1,i=1,c=4,r=2,C=1,m=1;/wAA\e\\"
send "\e[2J"
send "\e_Gm=0;AP8A\e\\"
dump frame
send "\e_Ga=p,i=1,C=1\e\\"
