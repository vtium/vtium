# A query sent in chunks is answered at its end and stores nothing.
# Rule P5 (decided 2026-11-13) of upload-rules.md.
# spec: the kitty graphics protocol (sw.kovidgoyal.net/kitty/graphics-protocol, read 2026-11-13)
# covers: image.kitty
size 20 10
send "\e_Ga=q,i=5,f=24,s=2,v=1,m=1;/wAA\e\\"
send "\e_Gm=0;AP8A\e\\"
send "\e_Ga=p,i=5,C=1\e\\"
