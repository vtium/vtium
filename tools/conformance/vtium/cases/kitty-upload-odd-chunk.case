# Each chunk's base64 is decoded on its own; a chunk short of a group of four is read as unpadded base64.
# Rule U1 of upload-rules.md.
# spec: the kitty graphics protocol (sw.kovidgoyal.net/kitty/graphics-protocol, read 2026-11-13)
# covers: image.kitty
size 20 10
send "\e_Ga=t,f=24,s=2,v=1,i=1,m=1;/wA\e\\"
send "\e_Gm=0;AAP8A\e\\"
