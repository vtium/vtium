# ICH inserts blank characters at the cursor and DCH deletes characters
# there, moving the rest of the line. An omitted or zero count means 1,
# and a count past the line stops at its end. A wide character that ICH
# or DCH cuts in half goes whole. From a pending wrap, ICH and DCH act
# on the last column.
# spec: ECMA-48 8.3.64 ICH and 8.3.26 DCH
# covers: ctl.edit
size 8 3
send "abcdefgh\e[1;3H\e[@"
dump state
send "\e[2@"
dump state
send "\e[0@\e[1;8H\e[@"
dump state
send "\e[1;6H\e[99@"
dump state
send "\e[2;1H01234567\e[2;3H\e[P"
dump state
send "\e[2P"
dump state
send "\e[0P\e[2;8H\e[P"
dump state
send "\e[2;2H\e[99P"
dump state
# Two wide characters that ICH and DCH cut in half.
send "\e[3;1Ha\u{4e16}\u{4e16}b\e[3;3H\e[@"
dump state
send "\e[3;3H\e[P\e[P"
dump state
# A pending wrap at the last column.
send "\e[3;1H01234567\e[@"
dump state
send "\e[3;1H01234567\e[P"
dump state
