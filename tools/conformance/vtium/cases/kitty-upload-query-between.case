# A query between chunks is answered on its own, and the upload continues.
# Rule P2 (decided 2026-11-13) of upload-rules.md.
# spec: the kitty graphics protocol (sw.kovidgoyal.net/kitty/graphics-protocol, read 2026-11-13)
# covers: image.kitty
size 20 10
send "\e_Ga=t,f=24,s=2,v=1,i=1,m=1;/wAA\e\\"
send "\e_Ga=q,i=5,f=24,s=1,v=1;AAAA\e\\"
send "\e_Ga=q,i=6,f=24,s=2,v=1;AAAA\e\\"
send "\e_Gm=0;AP8A\e\\"
send "\e_Ga=p,i=1,C=1\e\\"
