# In UTF-8 input, each character from U+00A1 to U+00FE prints as itself,
# whatever set G1 holds.
# spec: xterm's UTF-8 mode, as vtium-term's README describes it under "Character sets"
# covers: text.charsets
size 40 5
send "\u{a1}\u{a2}\u{a3}\u{a4}\u{a5}\u{a6}\u{a7}\u{a8}\u{a9}\u{aa}\u{ab}\u{ac}\u{ae}\u{af}"
send "\e)0\r\n\u{a1}\u{e0}\u{ea}\u{f8}\u{fe}"
send "\e)<\r\n\u{a1}\u{a4}\u{a8}\u{e0}\u{fe}"
send "\e)A\r\n\u{a1}\u{fe}"
dump state
