# A frame sent in chunks and short of its data is answered ENODATA.
# References: ADR-1100 D16.
# spec: kitty graphics protocol (sw.kovidgoyal.net/kitty/graphics-protocol, read 2026-11-13), "Remote client": "When sending animation frame data, subsequent chunks must also specify the a=f key."; ADR-1100 D16, "One answer for an upload"
# covers: image.kitty-animation
size 20 10
send "\e_Ga=t,f=24,s=2,v=1,i=2;AAD/AAD/\e\\"
send "\e_Ga=f,i=2,f=24,s=3,v=1,m=1;/wAA\e\\"
send "\e_Ga=f,m=0;AP8A\e\\"
