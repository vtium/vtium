# Refused transmissions. A format the spec does not define, raw data
# shorter than its width and height need, sent whole, in chunks and in
# f=8, and a picture past the largest size the host allows. q=2 silences
# a refusal and q=1 does not.
#
# References: ADR-1100 D15.
# spec: kitty graphics protocol, "Transferring pixel data", "Suppressing responses from the terminal" and "Control data reference"
# covers: image.kitty
size 12 2

# f=7 is no format of the spec.
send "\e_Ga=t,i=1,f=7,s=1,v=1;AAAA\e\\"

# Short data: 6 bytes for a 2×2 RGB picture, which needs 12; 4 bytes in
# two chunks for a 2×1 RGBA picture, which needs 8; 2 bytes for a 2×2
# f=8 picture, which needs 4.
send "\e_Ga=t,i=2,f=24,s=2,v=2;AAD/AAD/\e\\"
send "\e_Ga=t,i=3,f=32,s=2,v=1,m=1;AAD/\e\\"
send "\e_Gm=0;/w==\e\\"
send "\e_Ga=t,i=4,f=8,s=2,v=2;AQE=\e\\"

# The largest picture is 4×4 pixels, and image 5 is 5×1.
cmd graphic-max;w=4;h=4
send "\e_Ga=t,i=5,f=24,s=5,v=1;/wAA/wAA/wAA/wAA/wAA\e\\"
cmd graphic-max;w=0;h=0
dump

# q=2 silences a refusal, and q=1 leaves it.
send "\e_Ga=t,i=6,f=7,s=1,v=1,q=2;AAAA\e\\"
send "\e_Ga=t,i=7,f=7,s=1,v=1,q=1;AAAA\e\\"
