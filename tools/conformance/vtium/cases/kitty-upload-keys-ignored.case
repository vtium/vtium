# A chunk's keys other than m and q are ignored.
# Rule U2 of upload-rules.md.
# spec: the kitty graphics protocol (sw.kovidgoyal.net/kitty/graphics-protocol, read 2026-11-13)
# covers: image.kitty
size 20 10
send "\e_Ga=t,f=24,s=2,v=1,i=1,m=1;/wAA\e\\"
send "\e_Gm=0,i=7,f=32,s=9;AP8A\e\\"
send "\e_Ga=p,i=1,C=1\e\\"
send "\e_Ga=p,i=7,C=1\e\\"
