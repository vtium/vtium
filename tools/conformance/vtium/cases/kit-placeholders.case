# Kitty Unicode placeholders. Image 42 has one virtual placement, two
# cells by two. A 2×2 grid of placeholder cells gives every row and
# column mark. Cells that leave marks out after accented text take them
# from the cell to their left, even where that text spends the line's
# cluster budget. A placeholder cell under SGR 7, and the screen under
# DECSCNM, draw the cell's background as a blank cell would.
#
# References: ADR-1100 D13.
# spec: kitty graphics protocol, "Unicode placeholders"
# covers: image.kitty-placeholders
size 12 6
cmd cell;w=8;h=16

# Image 42 is 16×32 pixels of white and red, stored quietly.
# 16×32, white (ffffff) and red (ff0000)
send "\e_Ga=t,f=24,s=16,v=32,i=42,q=2;\e\\"

# The virtual placement is 2 columns by 2 rows.
send "\e_Ga=p,U=1,i=42,c=2,r=2,q=2\e\\"

# Rows 2 and 3 hold a 2×2 grid, each cell with its row and column marks.
send "\e[2;4H"
send "\e[38;5;42m\u{10EEEE}\u{305}\u{305}\u{10EEEE}\u{305}\u{30D}"
send "\e[3;4H\u{10EEEE}\u{30D}\u{305}\u{10EEEE}\u{30D}\u{30D}"
send "\e[m"
dump

# Rows 5 and 6 start with accented text, then placeholder cells that
# leave out their column marks, or every mark.
send "\e[5;1He\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}e\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}e\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}"
send "\e[38;5;42m\u{10EEEE}\u{305}\u{305}\u{10EEEE}"
send "\e[6;1H"
send "\e[39me\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}e\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}e\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}\u{301}"
send "\e[38;5;42m\u{10EEEE}\u{30D}\u{10EEEE}"
send "\e[m"
dump

# One placeholder cell under SGR 7 with a blue background, at the top left.
send "\e[1;1H"
send "\e[7;38;5;42;48;5;4m\u{10EEEE}\u{305}\u{305}"
send "\e[27;39m "
send "\e[m"
dump

# DECSCNM turns the whole screen to reverse video.
send "\e[?5h"
dump

# The stream ends with a cut, so the replay prints its last block twice.
# A case drops a cut at its end, so a second dump keeps that cut.
dump
