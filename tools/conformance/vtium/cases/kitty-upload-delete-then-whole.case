# After a delete ends the upload, a chunk that names every key is a command of its own.
# Rule U8 of upload-rules.md.
# spec: the kitty graphics protocol (sw.kovidgoyal.net/kitty/graphics-protocol, read 2026-11-13)
# covers: image.kitty
size 20 10
send "\e_Ga=t,f=24,s=2,v=1,i=1,m=1;/wAA\e\\"
send "\e_Ga=d\e\\"
send "\e_Gf=24,s=2,v=1,i=1,m=0;AP8A\e\\"
