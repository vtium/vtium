# A kitty placement moves with its lines when CSI S scrolls the whole
# screen up and when CSI T scrolls it down. The text beside it moves with
# it, and the line that leaves the top goes to the scrollback.
# spec: kitty graphics protocol, "Interaction with other terminal actions"
# covers: image.kitty
size 12 4

# The cell is 8×16 pixels, and the scrollback holds 10 lines.
cmd cell;w=8;h=16
cmd sb-max;n=10

# Picture 1 is one cell wide and two rows tall, placed at row 2 with C=1.
send "\e[2;1H"
# 8×32, every pixel opaque red (ff0000ff)
send "\e_Ga=T,f=32,s=8,v=32,i=1,C=1;\e\\"

# Text sits beside the picture, then CSI S scrolls the screen up one line.
send "\e[2;3Hab"
send "\e[S"
dump

# CSI 6 n reports the cursor, frame-since takes a frame, and CSI T scrolls
# the screen down one line.
send "\e[6n"
cmd frame-since;caller=0
send "\e[T"
