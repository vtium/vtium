# A chunk cut off by CAN or SUB ends its upload and fails it with EINVAL, under the upload's q. The old image under the same id stays.
# References: ADR-1100 D16.
# spec: ADR-1100 D16, "What ends an upload early"
# covers: image.kitty
size 20 10
send "\e_Ga=t,f=24,s=2,v=1,i=1,m=1;/wAA\e\\"
send "\e_Gm=1;AP8\x18"
send "\e_Gm=0;AP8A\e\\"
send "\e_Ga=p,i=1,C=1\e\\"
send "\e_Ga=t,f=24,s=2,v=1,i=2,q=2,m=1;/wAA\e\\"
send "\e_Gm=1;AP8\x1a"
send "\e_Ga=p,i=2,C=1\e\\"
send "\e_Ga=t,f=24,s=1,v=1,i=3;AAD/\e\\"
send "\e_Ga=t,f=24,s=2,v=1,i=3,m=1;/wAA\e\\"
send "\e_Gm=1;AP8\x18"
send "\e_Ga=p,i=3,C=1\e\\"
