# A later chunk's q=0 leaves the upload's q.
# References: ADR-1100 D16.
# spec: kitty graphics protocol (sw.kovidgoyal.net/kitty/graphics-protocol, read 2026-11-13), "Suppressing responses from the terminal": "Set it to 1 to suppress OK responses and to 2 to suppress failure responses."; ADR-1100 D16, "`q` across chunks"
# covers: image.kitty
size 20 10
send "\e_Ga=t,f=24,s=3,v=1,i=1,q=2,m=1;/wAA\e\\"
send "\e_Gm=0,q=0;AP8A\e\\"
send "\e_Ga=p,i=1,C=1\e\\"
