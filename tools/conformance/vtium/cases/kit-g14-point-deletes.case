# The kitty deletes by cell (d=p), by cell and z (d=q), by column (d=x)
# and by row (d=y) take kitty placements. A sixel picture in the same
# cells stays, since kitty's deletes never reach a sixel.
# spec: kitty graphics protocol, "Deleting images"
# covers: image.kitty
size 12 4
cmd cell;w=8;h=16

# A sixel picture, two cells wide, sits at the top left.
cmd image;n=0;w=16;h=16
cmd place;img=0;col=0;row=0

# Kitty picture 1, at z 1, covers columns 3 and 4 of row 1.
send "\e[1;3H"
# 16×16, every pixel opaque red (ff0000ff)
send "\e_Ga=T,f=32,s=16,v=16,i=1,C=1,z=1;\e\\"

# Kitty picture 2, at z 2, covers columns 3 and 4 of row 2.
send "\e[2;3H"
# 16×16, every pixel opaque red (ff0000ff)
send "\e_Ga=T,f=32,s=16,v=16,i=2,C=1,z=2;\e\\"

# d=p at cell 1,1 finds only the sixel, and d=p at 3,1 takes picture 1.
send "\e_Ga=d,d=p,x=1,y=1\e\\"
send "\e_Ga=d,d=p,x=3,y=1\e\\"
dump

# d=q at 4,2 with z 1 finds nothing, and with z 2 it takes picture 2.
send "\e_Ga=d,d=q,x=4,y=2,z=1\e\\"
send "\e_Ga=d,d=q,x=4,y=2,z=2\e\\"
dump

# Picture 1 is placed again at the cursor, on row 2. d=x on column 1 and
# d=y on row 1 find no kitty placement there.
send "\e_Ga=p,i=1,C=1\e\\"
send "\e_Ga=d,d=x,x=1\e\\"
send "\e_Ga=d,d=y,y=1\e\\"
