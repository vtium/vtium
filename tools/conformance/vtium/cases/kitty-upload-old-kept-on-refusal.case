# A refused upload leaves the old image under the same id.
# References: ADR-1100 D16.
# spec: kitty graphics protocol (sw.kovidgoyal.net/kitty/graphics-protocol, read 2026-11-13), "Remote client": "terminals must not display anything, until the entire sequence is received and validated"; ADR-1100 D16, "The reservation, and the old image under the same id"
# covers: image.kitty
size 20 10
send "\e_Ga=t,f=24,s=1,v=1,i=1;AAD/\e\\"
send "\e_Ga=t,f=24,s=3,v=1,i=1,m=1;/wAA\e\\"
send "\e_Gm=0;AP8A\e\\"
send "\e_Ga=p,i=1,C=1\e\\"
