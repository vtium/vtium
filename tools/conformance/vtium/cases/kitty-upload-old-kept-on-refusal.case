# A refused upload leaves the old image under the same id.
# Rule P1 (decided 2026-11-13) of upload-rules.md.
# spec: the kitty graphics protocol (sw.kovidgoyal.net/kitty/graphics-protocol, read 2026-11-13)
# covers: image.kitty
size 20 10
send "\e_Ga=t,f=24,s=1,v=1,i=1;AAD/\e\\"
send "\e_Ga=t,f=24,s=3,v=1,i=1,m=1;/wAA\e\\"
send "\e_Gm=0;AP8A\e\\"
send "\e_Ga=p,i=1,C=1\e\\"
