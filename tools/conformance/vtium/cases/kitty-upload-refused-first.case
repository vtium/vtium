# A first chunk refused by its keys is answered at once and opens no upload.
# Rule U5 of upload-rules.md.
# spec: the kitty graphics protocol (sw.kovidgoyal.net/kitty/graphics-protocol, read 2026-11-13)
# covers: image.kitty
size 20 10
send "\e_Ga=t,f=7,s=2,v=1,i=1,m=1;/wAA\e\\"
send "\e_Gm=1;AP8A\e\\"
send "\e_Gm=0,i=4;AAD/\e\\"
send "\e_Ga=t,f=24,s=1,v=1,i=2;AAD/\e\\"
send "\e_Ga=p,i=1,C=1\e\\"
send "\e_Ga=p,i=2,C=1\e\\"
