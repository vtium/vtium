# DECRC puts the cursor back where it was on the screen when DECSC saved
# it, and sets origin mode as it was then, whatever the mode is when
# DECRC runs.
# spec: the VT510 manual, DECSC and DECRC
# covers: ctl.decsc
size 10 8
send "\e[3;6r"
send "\e[2;5H\e7\e[?6h\e[3;3H"
dump state
send "\e8X"
dump state
send "\e[?6h\e[2;2H\e7\e[?6l\e[8;8H"
send "\e8Y"
dump state
send "\e[?6h\e[4;7H\e7\e[?6l\e[1;1H\e8Z"
dump state
