# The refusals of kitty relative placements. A chain eight placements deep
# is allowed, and a ninth level is ETOODEEP. A parent that does not exist
# is ENOPARENT. A placement that would make a cycle is ECYCLE. A virtual
# placement (U=1) is refused with a parent and allowed alone.
#
# References: ADR-1100 D13 and D15.
# spec: kitty graphics protocol, "Relative placements"
# covers: image.kitty-relative
size 12 4
cmd cell;w=8;h=16

# Picture 1, placement 1, is the root of the chain. Images 2 and 3 are
# stored without a placement.
# 8×16, every pixel opaque red (ff0000ff)
send "\e_Ga=T,f=32,s=8,v=16,i=1,p=1,C=1,q=2;\e\\"
# 8×16, every pixel opaque blue (0000ffff)
send "\e_Ga=t,f=32,s=8,v=16,i=2,q=2;\e\\"
# 8×16, every pixel opaque green (00ff00ff)
send "\e_Ga=t,f=32,s=8,v=16,i=3,q=2;\e\\"

# Placements 1 to 8 of image 2 make a chain eight deep, each under the
# one before it.
send "\e_Ga=p,i=2,p=1,P=1,Q=1,H=1,q=1\e\\"
send "\e_Ga=p,i=2,p=2,P=2,Q=1,H=1,q=1\e\\"
send "\e_Ga=p,i=2,p=3,P=2,Q=2,H=1,q=1\e\\"
send "\e_Ga=p,i=2,p=4,P=2,Q=3,H=1,q=1\e\\"
send "\e_Ga=p,i=2,p=5,P=2,Q=4,H=1,q=1\e\\"
send "\e_Ga=p,i=2,p=6,P=2,Q=5,H=1,q=1\e\\"
send "\e_Ga=p,i=2,p=7,P=2,Q=6,H=1,q=1\e\\"
send "\e_Ga=p,i=2,p=8,P=2,Q=7,H=1,q=1\e\\"
dump

# A parent image that does not exist, a parent placement that does not
# exist, and a parent image with no placement are each ENOPARENT.
send "\e_Ga=p,i=3,p=1,P=9\e\\"
send "\e_Ga=p,i=3,p=1,P=1,Q=5\e\\"
send "\e_Ga=p,i=3,p=1,P=3\e\\"
dump

# Replacing the root under the chain's last placement would make a
# cycle. Making placement 4 its own parent is refused too.
send "\e_Ga=p,i=1,p=1,P=2,Q=8\e\\"
send "\e_Ga=p,i=2,p=4,P=2,Q=4\e\\"
dump

# A ninth level under the chain's last placement is too deep.
send "\e_Ga=p,i=3,p=1,P=2,Q=8\e\\"
dump

# A virtual placement (U=1) alone is allowed, and U=1 with a parent is
# refused. A relative placement under the virtual placement is allowed.
send "\e_Ga=p,i=3,p=2,U=1,c=2,r=1\e\\"
send "\e_Ga=p,i=3,p=3,U=1,P=1,Q=1\e\\"
send "\e_Ga=p,i=3,p=4,P=3,Q=2,H=1\e\\"
