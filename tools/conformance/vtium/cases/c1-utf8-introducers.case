# CSI, OSC, DCS, SOS, PM, APC and ST sent as UTF-8 code points start and
# end nothing in UTF-8 input, so the text after each prints.
# spec: ECMA-48 5.3, which defines C1 for 7-bit and 8-bit codes only; vtium-parse's README, "C1 controls do nothing in UTF-8 mode"
size 20 4
send "\u{9b}1mA\u{9b}0m"
send "\u{9d}0;one\u{9c}"
send "\u{9d}0;two\a"
send "\u{9d}10;?\u{9c}"
send "\u{90}1;2qdata\u{9c}B"
send "\u{98}sos\u{9c}C"
send "\u{9e}pm\u{9c}D"
send "\u{9f}apc\u{9c}E"
dump state
