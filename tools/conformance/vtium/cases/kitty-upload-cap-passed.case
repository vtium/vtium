# A chunk that takes an upload past its reservation fails the upload, whatever command carried it.
# Rule B2 (decided 2026-11-13) of upload-rules.md.
# spec: the kitty graphics protocol (sw.kovidgoyal.net/kitty/graphics-protocol, read 2026-11-13)
# covers: image.kitty
# The 1x1 RGB upload reserves 4 + 512 = 516 bytes. The frame, the upload's next chunk, brings 516 more, 519 in all.
size 20 10
send "\e_Ga=t,f=24,s=1,v=1,i=1,m=1;/wAA\e\\"
send "\e_Ga=f,i=2,f=24,s=1,v=1,m=1;\e\\"
send "\e_Gm=0;AP8A\e\\"
send "\e_Ga=p,i=1,C=1\e\\"
