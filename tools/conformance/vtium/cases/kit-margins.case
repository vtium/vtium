# Kitty placements inside left and right margins. A line feed at the
# bottom margin, with the cursor between the left and right margins,
# scrolls the rectangle between the four margins. It moves a placement
# wholly inside the rectangle and leaves one that crosses the right
# margin. The cursor after a placement that passes the right margin goes
# down a row to the left margin, from inside the margins and from right of
# them.
#
# References: ADR-1100 D6.
# spec: kitty graphics protocol, "Controlling displayed image layout" and "Interaction with other terminal actions"; ctlseqs, DECSLRM
# covers: image.kitty
size 12 6
cmd cell;w=8;h=16

# Six rows of letters, then DECLRMM on, rows 2 to 5 and columns 3 to 8.
send "\e[1;1Haaaaaaaaaaaa"
send "\e[2;1Hbbbbbbbbbbbb"
send "\e[3;1Hcccccccccccc"
send "\e[4;1Hdddddddddddd"
send "\e[5;1Heeeeeeeeeeee"
send "\e[6;1Hffffffffffff"
send "\e[?69h"
send "\e[2;5r"
send "\e[3;8s"
dump

# Picture 1, one cell wide and two rows tall, lies inside the rectangle.
send "\e[4;4H"
# 8×32, every pixel opaque blue (0000ffff)
send "\e_Ga=T,f=32,s=8,v=32,i=1,C=1;\e\\"

# Picture 2, two cells wide, crosses the right margin at column 8.
send "\e[3;8H"
# 16×16, every pixel opaque red (ff0000ff)
send "\e_Ga=T,f=32,s=16,v=16,i=2,C=1;\e\\"
dump

# A line feed at the bottom margin, from column 4, scrolls the rectangle.
send "\e[5;4H\n"
dump

# Picture 3, three cells wide from column 7, passes the right margin, and
# the cursor moves after it.
send "\e[2;7H"
# 24×16, every pixel opaque green (00ff00ff)
send "\e_Ga=T,f=32,s=24,v=16,i=3,C=0;\e\\"
dump

# Picture 4, two cells wide from column 11, right of the margins, and the
# cursor moves after it.
send "\e[2;11H"
# 16×16, every pixel opaque blue (0000ffff)
send "\e_Ga=T,f=32,s=16,v=16,i=4,C=0;\e\\"
