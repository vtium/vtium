# CUU, CUD, CUF and CUB move the cursor by a count, where an omitted or
# zero count means 1, and stop at the screen's edge. With a scrolling
# region set, CUU stops at its top margin and CUD at its bottom margin,
# also when the cursor starts outside the region beyond the other margin.
# The last screens send CUB, CUF and CUU from a pending wrap at the last
# column.
# spec: ECMA-48 8.3.22 CUU, 8.3.19 CUD, 8.3.20 CUF and 8.3.18 CUB; the VT510 manual, CUU and CUD (the margins)
# covers: ctl.edit
size 10 6
send "\e[4;5H"
send "\e[A"
dump state
send "\e[0A"
dump state
send "\e[2A"
dump state
send "\e[99A"
dump state
send "\e[B\e[0B\e[2B"
dump state
send "\e[99B"
dump state
send "\e[C\e[0C\e[3C"
dump state
send "\e[99C"
dump state
send "\e[D\e[0D\e[3D"
dump state
send "\e[99D"
dump state
# A scrolling region from row 2 to row 4.
send "\e[2;4r\e[3;1H\e[9A"
dump state
send "\e[9B"
dump state
send "\e[1;1H\e[9B"
dump state
send "\e[6;1H\e[9A"
dump state
send "\e[5;1H\e[9A"
dump state
# No region, and a pending wrap at the last column.
send "\e[r\e[1;1H0123456789"
dump state
send "\e[D"
dump state
send "\e[1;1H0123456789\e[C"
dump state
send "\e[1;1H0123456789\e[A"
dump state
