# vtium's own capability probes, in probes.replay's format (README.md, The
# probes). A probe here takes the place of a placeholder of the same name
# in the copied probes.replay, and may not take the name of any other
# probe there.

# OSC 52 copy: the host takes what a program set, once (#110; the
# interface's clipboard command, INTERFACE-vtium.md)
probe osc-52-clipboard
size 8 1
send "\e]52;c;aGVsbG8=\e\\"
cmd clipboard
cmd clipboard
check
want test clipboard 68656c6c6f
want test clipboard none

# --- the modes and controls the copied probes do not cover (#54) ---

# DECALN (ESC # 8): every cell an E, origin mode off and the cursor home,
# and the margins the whole screen: the region before it leaves out the
# last row, where a line feed scrolls only once the margins are reset
probe decaln
size 4 3
send "ab\e[1;2r\e[?6h\e[2;2H\e#8"
check
want row 0 |EEEE|
want row 1 |EEEE|
want row 2 |EEEE|
want cursor 0,0
reject-re flags .*REL_ORIGIN.*
send "\e[3;1H\n"
check
want row 1 |EEEE|
want row 2 ||

# mode 45, reverse wraparound: reset, BS stops at the first column; set,
# BS goes on to the last column of the row that wrapped into this one,
# and not into a row that did not
probe reverse-wrap
size 4 3
send "abcdefg\r\x08"
check
want cursor 0,1
send "\e[?45h\x08"
check
want cursor 3,0
send "\e[?45$p"
check
reply "\e[?45;1$y"
send "\e[3;1Hx\r\x08"
check
want cursor 0,2

# XTSAVE and XTRESTORE: one mode saved and restored; the empty list saves
# and restores 1000's tracking, and leaves DECOM, which moves the cursor
probe xtsave
size 80 4
send "\e[?25l\e[?25s\e[?25h\e[?25r\e[?25$p"
check
reply "\e[?25;2$y"
send "\e[?1000h\e[?s\e[?1003h\e[?6h\e[3;4H\e[?r\e[?1000$p"
check
reply "\e[?1000;1$y"
want cursor 3,2

# mode 1015, the urxvt encoding: CSI Cb ; Cx ; Cy M in decimal, a release
# button 3
probe mouse-1015
size 80 4
send "\e[?1000h\e[?1015h"
check
cmd mouse;col=2;row=3;px=20;py=30;button=left;event=press
check
reply "\e[32;3;4M"
cmd mouse;col=2;row=3;px=20;py=30;button=left;event=release
check
reply "\e[35;3;4M"

# mode 66, DECNKM: the keypad's application mode, which DECKPNM resets
probe decnkm
size 80 4
send "\e[?66h"
check
cmd key;sym=ffb1
check
reply "\eOq"
send "\e>\e[?66$p"
check
reply "\e[?66;2$y"

# modes 1036 and 1034: Alt puts ESC before a key; with 1036 reset, it sets
# the key's eighth bit, sent as UTF-8
probe meta-keys
size 80 4
cmd key;sym=61;ascii=61;unicode=61;mods=8
check
reply "\ea"
send "\e[?1036l"
check
cmd key;sym=61;ascii=61;unicode=61;mods=8
check
reply "\xc3\xa1"
