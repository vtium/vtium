# Two kitty pictures sent in chunks with a=T. Text arrives between the
# first picture's first chunk and its second; the upload stays open, and
# the picture is placed at the cursor as it is when its last chunk
# arrives. CSI 6 n reports the cursor after each picture. The second
# picture, 8×8 RGBA, comes in 32 chunks with q=1.
#
# References: ADR-1100 D16.
# spec: ADR-1100 D16, "What leaves an upload open"; kitty graphics protocol (sw.kovidgoyal.net/kitty/graphics-protocol, read 2026-11-13), "Remote client": "the cursor position used to display the image must be the position when the final chunk is received"
# covers: image.kitty
size 12 4
cmd cell;w=8;h=16

# Picture 1, 8×16 RGB, opens with its first chunk; "ab" follows, then
# its 63 further chunks, the last with m=0.
send "\e_Ga=T,f=24,s=8,v=16,i=1,m=1;AAD/AAD/\e\\"
send "ab"
send "\e_Gm=1;AAD/AAD/\e\\"
send "\e_Gm=1;AAD/AAD/\e\\"
send "\e_Gm=1;AAD/AAD/\e\\"
send "\e_Gm=1;AAD/AAD/\e\\"
send "\e_Gm=1;AAD/AAD/\e\\"
send "\e_Gm=1;AAD/AAD/\e\\"
send "\e_Gm=1;AAD/AAD/\e\\"
send "\e_Gm=1;AAD/AAD/\e\\"
send "\e_Gm=1;AAD/AAD/\e\\"
send "\e_Gm=1;AAD/AAD/\e\\"
