# Image 3: CAN cuts its second chunk off, which ends the upload and fails it with EINVAL; its 62 further chunks and its last are commands of their own.
send "\e_Ga=T,f=24,s=8,v=16,i=3,m=1;AAD/AAD/\e\\"
send "\e_Gm=1;AAAA\x18"
send "\e_Gm=1;AAD/AAD/\e\\"
send "\e_Gm=1;AAD/AAD/\e\\"
send "\e_Gm=1;AAD/AAD/\e\\"
send "\e_Gm=1;AAD/AAD/\e\\"
send "\e_Gm=1;AAD/AAD/\e\\"
