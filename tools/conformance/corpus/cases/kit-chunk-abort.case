send "\e_Gm=1;AAD/AAD/\e\\"
send "\e_Gm=1;AAD/AAD/\e\\"
send "\e_Gm=1;AAD/AAD/\e\\"
send "\e_Gm=1;AAD/AAD/\e\\"
send "\e_Gm=0;AAD/AAD/\e\\"

# Image 2: a put of image 9, which does not exist, between its first and second chunks leaves the upload open, and the picture is placed.
send "\e_Ga=T,f=24,s=8,v=16,i=2,m=1;AAD/AAD/\e\\"
send "\e_Ga=p,i=9\e\\"
send "\e_Gm=1;AAD/AAD/\e\\"
send "\e_Gm=1;AAD/AAD/\e\\"
send "\e_Gm=1;AAD/AAD/\e\\"
send "\e_Gm=1;AAD/AAD/\e\\"
