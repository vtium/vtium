# Three kitty uploads in chunks: one a delete aborts, one a put runs beside, and one CAN cuts off.
#
# References: ADR-1100 D16.
# spec: kitty graphics protocol (sw.kovidgoyal.net/kitty/graphics-protocol, read 2026-11-13), "Deleting images": "If an image is being loaded in chunks and the upload is not complete when any delete command is received, the partial upload must be aborted."; ADR-1100 D16, "What ends an upload early" (a chunk cut off by CAN or SUB)
# covers: image.kitty
size 12 4
cmd cell;w=8;h=16

# Image 1, 8×16 RGB, a=T: a delete arrives after its first chunk and ends the upload, so its 62 further chunks and its last are commands of their own.
send "\e_Ga=T,f=24,s=8,v=16,i=1,m=1;AAD/AAD/\e\\"
send "\e_Ga=d\e\\"
send "\e_Gm=1;AAD/AAD/\e\\"
send "\e_Gm=1;AAD/AAD/\e\\"
send "\e_Gm=1;AAD/AAD/\e\\"
send "\e_Gm=1;AAD/AAD/\e\\"
send "\e_Gm=1;AAD/AAD/\e\\"
send "\e_Gm=1;AAD/AAD/\e\\"
send "\e_Gm=1;AAD/AAD/\e\\"
send "\e_Gm=1;AAD/AAD/\e\\"
send "\e_Gm=1;AAD/AAD/\e\\"
send "\e_Gm=1;AAD/AAD/\e\\"
send "\e_Gm=1;AAD/AAD/\e\\"
send "\e_Gm=1;AAD/AAD/\e\\"
send "\e_Gm=1;AAD/AAD/\e\\"
send "\e_Gm=1;AAD/AAD/\e\\"
send "\e_Gm=1;AAD/AAD/\e\\"
send "\e_Gm=1;AAD/AAD/\e\\"
send "\e_Gm=1;AAD/AAD/\e\\"
send "\e_Gm=1;AAD/AAD/\e\\"
send "\e_Gm=1;AAD/AAD/\e\\"
send "\e_Gm=1;AAD/AAD/\e\\"
send "\e_Gm=1;AAD/AAD/\e\\"
send "\e_Gm=1;AAD/AAD/\e\\"
send "\e_Gm=1;AAD/AAD/\e\\"
send "\e_Gm=1;AAD/AAD/\e\\"
send "\e_Gm=1;AAD/AAD/\e\\"
send "\e_Gm=1;AAD/AAD/\e\\"
send "\e_Gm=1;AAD/AAD/\e\\"
send "\e_Gm=1;AAD/AAD/\e\\"
send "\e_Gm=1;AAD/AAD/\e\\"
send "\e_Gm=1;AAD/AAD/\e\\"
send "\e_Gm=1;AAD/AAD/\e\\"
send "\e_Gm=1;AAD/AAD/\e\\"
send "\e_Gm=1;AAD/AAD/\e\\"
